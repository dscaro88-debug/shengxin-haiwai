---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og-default.png' } = Astro.props;
const siteTitle = SITE.name;
const nav = [
  { href: '/', label: '首页' },
  { href: '/earn-haitao', label: '海淘省钱' },
  { href: '/earn-taobaoke', label: '淘宝客副业' },
  { href: '/earn-crossborder', label: '跨境副业' },
  { href: '/category/海淘省钱', label: '省钱攻略' },
  { href: '/about', label: '关于' },
  { href: '/cooperation', label: '商务合作' },
];
const joinUrl = SITE.joinUrl;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <ClientRouter />
</head>
<body>
  <header class="site-header">
    <div class="container header-in">
      <a href="/" class="logo"><img src="/logo.svg" alt={siteTitle} class="logo-icon" width="30" height="30" /><span class="logo-text">{siteTitle}</span></a>
      <nav>
        {nav.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="btn-wechat" href={joinUrl}>加入社群</a>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="cols">
        <div>
          <h4>雪球·智慧</h4>
          <a href="/">首页</a>
          <a href="/earn-haitao">海淘省钱线</a>
          <a href="/earn-taobaoke">淘宝客副业线</a>
          <a href="/earn-crossborder">跨境副业线</a>
          <a href="/category/海淘省钱">省钱攻略</a>
        </div>
        <div>
          <h4>关于</h4>
          <a href="/about">我们是谁</a>
          <a href="/cooperation">商务合作</a>
          <a href={joinUrl}>读者福利群</a>
        </div>
        <div>
          <h4>关注我们</h4>
          <a href={joinUrl}>微信社群</a>
          <a href="/about">小红书：{SITE.xiaohongshu}</a>
          <a href="/sitemap-index.xml">站点地图</a>
        </div>
      </div>
      <div class="legal">
        <p>{SITE.disclosure}</p>
        <p>© {new Date().getFullYear()} {siteTitle} SnowballWise · 让每一笔省钱，都滚得聪明 · 内容仅供参考，优惠以官方页面为准。</p>
      </div>
    </div>
  </footer>
</body>
</html>
