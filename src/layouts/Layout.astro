---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og-default.png' } = Astro.props;
const siteTitle = '雪球·智慧';
const nav = [
  { href: '/', label: '首页' },
  { href: '/category/海淘省钱', label: '海淘省钱' },
  { href: '/category/副业赚钱', label: '副业赚钱' },
  { href: '/category/高佣Deal', label: '高佣Deal' },
  { href: '/category/AI决策', label: 'AI决策' },
  { href: '/about', label: '关于' },
  { href: '/cooperation', label: '商务合作' },
];
// ⚠️ 改成你自己的微信群/表单链接
const wechatGroupUrl = 'https://your-link-to-wechat-group.example.com';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <ClientRouter />
</head>
<body>
  <header class="site-header">
    <div class="container header-in">
      <a href="/" class="logo"><img src="/logo.svg" alt="雪球·智慧" class="logo-icon" width="30" height="30" /><span class="logo-text">{siteTitle}</span></a>
      <nav>
        {nav.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="btn-wechat" href={wechatGroupUrl}>加入社群</a>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="cols">
        <div>
          <h4>雪球·智慧</h4>
          <a href="/">首页</a>
          <a href="/category/海淘省钱">海淘省钱</a>
          <a href="/category/副业赚钱">副业赚钱</a>
          <a href="/category/高佣Deal">高佣优惠</a>
        </div>
        <div>
          <h4>关于</h4>
          <a href="/about">我们是谁</a>
          <a href="/cooperation">商务合作</a>
          <a href={wechatGroupUrl}>读者福利群</a>
        </div>
        <div>
          <h4>关注我们</h4>
          <a href={wechatGroupUrl}>微信公众号</a>
          <a href={wechatGroupUrl}>小红书</a>
          <a href="/sitemap-index.xml">站点地图</a>
        </div>
      </div>
      <div class="legal">
        <p>本站为联盟营销（Affiliate）网站。部分链接为推广链接，您通过链接注册或消费，本站可能获得佣金，<strong>不会增加您的任何费用</strong>。</p>
        <p>© {new Date().getFullYear()} 雪球·智慧 SnowballWise · 让每一笔省钱，都滚得聪明 · 内容仅供参考，优惠以官方页面为准。</p>
      </div>
    </div>
  </footer>
</body>
</html>
