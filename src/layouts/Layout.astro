---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og-default.png' } = Astro.props;
const siteTitle = '省心海外';
const nav = [
  { href: '/', label: '首页' },
  { href: '/category/购物返利', label: '购物返利' },
  { href: '/category/信用卡开卡', label: '信用卡' },
  { href: '/category/银行开户', label: '银行开户' },
  { href: '/category/华人电商', label: '华人电商' },
  { href: '/category/生活优惠', label: '生活优惠' },
  { href: '/about', label: '关于' },
  { href: '/cooperation', label: '商务合作' },
];
// ⚠️ 改成你自己的微信群/表单链接
const wechatGroupUrl = 'https://your-link-to-wechat-group.example.com';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <ClientRouter />
</head>
<body>
  <header class="site-header">
    <div class="container header-in">
      <a href="/" class="logo"><span class="dot"></span>{siteTitle}</a>
      <nav>
        {nav.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="btn-wechat" href={wechatGroupUrl}>加微信群</a>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="cols">
        <div>
          <h4>省心海外</h4>
          <a href="/">首页</a>
          <a href="/category/信用卡开卡">高佣优惠</a>
          <a href="/category/华人电商">华人电商</a>
        </div>
        <div>
          <h4>关于</h4>
          <a href="/about">我们是谁</a>
          <a href="/cooperation">商务合作</a>
          <a href={wechatGroupUrl}>读者福利群</a>
        </div>
        <div>
          <h4>关注我们</h4>
          <a href={wechatGroupUrl}>微信公众号</a>
          <a href={wechatGroupUrl}>小红书</a>
          <a href="/sitemap-index.xml">站点地图</a>
        </div>
      </div>
      <div class="legal">
        <p>本站为联盟营销（Affiliate）网站。部分链接为推广链接，您通过链接注册或消费，本站可能获得佣金，<strong>不会增加您的任何费用</strong>。</p>
        <p>© {new Date().getFullYear()} 省心海外 · 内容仅供参考，优惠以官方页面为准。投资/开户类决策请自行评估风险。</p>
      </div>
    </div>
  </footer>
</body>
</html>
