---
import { SITE } from '../config';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>雪球·智慧 — 让每一笔消费都变成你的资产</title>
<meta name="description" content="加入雪球·智慧微信社群：每日精选真实划算好物、副业实操、一对一答疑。扫码加微信，领《海淘避坑+淘宝客起步清单》。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root{
  --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
  --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
  --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
  --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
  --s1:8px;--s2:16px;--s3:24px;--s4:32px;--s5:48px;--s6:64px;--s7:96px;--s8:120px;
  --r-sm:12px;--r:18px;--r-lg:26px;--r-xl:32px;
  --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
  --sh-md:0 6px 16px rgba(15,23,42,.06),0 14px 34px rgba(15,23,42,.08);
  --sh-lg:0 14px 40px rgba(15,23,42,.10),0 36px 80px rgba(15,23,42,.12);
  --sh-em:0 18px 44px rgba(5,150,105,.26);
  --ease:cubic-bezier(.22,.61,.36,1);--ease-out:cubic-bezier(.16,1,.3,1);
  --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
  --maxw:1160px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink-700);background:var(--bg);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.container{max-width:var(--maxw);margin:0 auto;padding:0 28px}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
h1,h2,h3{color:var(--ink-900);letter-spacing:-.025em;line-height:1.1}
.display{font-size:clamp(42px,5.6vw,66px);font-weight:800;letter-spacing:-.035em;line-height:1.06}
h2{font-size:clamp(29px,3.8vw,44px);font-weight:740;letter-spacing:-.025em}
h3{font-size:21px;font-weight:680}
.lead{font-size:clamp(17px,1.5vw,19px);color:var(--ink-600);line-height:1.65}
.muted{color:var(--ink-500)}

/* 顶栏 */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;transition:all .4s var(--ease);padding:18px 0}
.nav.scrolled{background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(18px);box-shadow:var(--sh-sm);padding:12px 0}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;color:var(--ink-900)}
.brand .mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(150deg,var(--em-500),var(--em-800));display:grid;place-items:center;box-shadow:var(--sh-em)}
.nav-links{display:flex;gap:30px;font-size:15px;font-weight:500;color:var(--ink-600)}
.nav-links a{transition:color .2s}.nav-links a:hover{color:var(--em-600)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:650;font-size:15px;border-radius:14px;padding:13px 24px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s;cursor:pointer;border:none}
.btn-primary{background:var(--em-600);color:#fff;box-shadow:var(--sh-em)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(5,150,105,.36)}
.btn-ghost{background:#fff;color:var(--ink-800);border:1px solid var(--line);box-shadow:var(--sh-sm)}
.btn-ghost:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
.btn-wechat{background:#07c160;color:#fff;box-shadow:0 14px 32px rgba(7,193,96,.3)}
.btn-wechat:hover{transform:translateY(-2px);box-shadow:0 20px 44px rgba(7,193,96,.4)}
@media(max-width:860px){.nav-links{display:none}}

/* Hero — 左文右大图 紧凑分栏 */
.hero{position:relative;padding:148px 0 var(--s7);background:
  radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),
  radial-gradient(80% 60% at 0% 0%,rgba(6,78,59,.05),transparent 50%),var(--bg);overflow:hidden}
.hero-grid{max-width:var(--maxw);margin:0 auto;padding:0 28px;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}
.hero-copy .display{margin-top:4px}
.hero-copy .lead{margin-top:22px;max-width:480px}
.hero-cta{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap}
.hero-trust{display:flex;flex-direction:column;gap:12px;margin-top:34px}
.hero-trust span{display:inline-flex;align-items:center;gap:9px;font-size:14.5px;color:var(--ink-600);font-weight:500}
.hero-trust svg{color:var(--em-500);flex:none}
.hero-visual{position:relative}
.hero-visual img{width:100%;border-radius:var(--r-xl);box-shadow:var(--sh-lg);background:#fff}
.hero-visual .tag{position:absolute;left:22px;bottom:22px;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:13px;padding:11px 16px;box-shadow:var(--sh-md);display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:650;color:var(--ink-800)}
.hero-visual .tag .ic{width:30px;height:30px;border-radius:9px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;flex:none}
@media(max-width:880px){.hero-grid{grid-template-columns:1fr;gap:40px}.hero-visual{order:-1}.hero-trust{flex-direction:row;flex-wrap:wrap;gap:18px}}

/* 通用 section */
section.block{padding:var(--s8) 0}
.sec-head{max-width:680px;margin:0 auto 56px;text-align:center}
.sec-head .lead{margin-top:16px}

/* 产品三件套 */
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.pcard{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:34px 30px;box-shadow:var(--sh-sm);transition:transform .35s var(--ease),box-shadow .35s var(--ease);position:relative;overflow:hidden}
.pcard::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--em-500),var(--em-300))}
.pcard:hover{transform:translateY(-8px);box-shadow:var(--sh-lg)}
.pcard .pic{width:56px;height:56px;border-radius:16px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:22px}
.pcard h3{margin-bottom:10px}
.pcard p{font-size:15px;color:var(--ink-600);margin-bottom:18px}
.pcard ul{list-style:none;display:flex;flex-direction:column;gap:11px}
.pcard li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--ink-700)}
.pcard li svg{color:var(--em-500);flex:none;margin-top:3px}
.platforms{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.platforms span{font-size:12px;font-weight:600;color:var(--em-700);background:var(--em-50);border-radius:8px;padding:5px 11px}
@media(max-width:880px){.cards3{grid-template-columns:1fr}}

/* 第3口塘 钩子 */
.hook{background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);padding:54px 56px;color:#fff;position:relative;overflow:hidden;box-shadow:var(--sh-em)}
.hook::after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(110,231,183,.18),transparent 70%)}
.hook .bell{width:54px;height:54px;border-radius:15px;background:rgba(255,255,255,.14);display:grid;place-items:center;margin-bottom:20px;color:#6ee7b7}
.hook h2{color:#fff;max-width:680px}
.hook p{color:rgba(255,255,255,.86);font-size:17px;max-width:640px;margin-top:14px}
.hook .row{display:flex;gap:14px;margin-top:28px;flex-wrap:wrap;position:relative;z-index:2}
.hook .btn-ghost{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.28)}
.hook .btn-ghost:hover{background:rgba(255,255,255,.2)}
@media(max-width:680px){.hook{padding:38px 26px}}

/* 三步 */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.step{text-align:center;padding:10px}
.step .num{width:52px;height:52px;margin:0 auto 18px;border-radius:16px;background:var(--bg-tint);border:1px solid var(--em-200);color:var(--em-700);font-weight:800;font-size:20px;display:grid;place-items:center}
.step h3{font-size:19px;margin-bottom:8px}
.step p{font-size:15px;color:var(--ink-600)}
@media(max-width:880px){.steps{grid-template-columns:1fr;gap:18px}}

/* 评价 */
.testi{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:24px}
.tcard{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px;box-shadow:var(--sh-sm)}
.tcard .stars{color:var(--em-500);font-size:15px;letter-spacing:2px;margin-bottom:14px}
.tcard p{font-size:15px;color:var(--ink-700);line-height:1.7}
.tcard .who{display:flex;align-items:center;gap:12px;margin-top:20px}
.tcard .av{width:42px;height:42px;border-radius:50%;background:linear-gradient(150deg,var(--em-400),var(--em-800));color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px;flex:none}
.tcard .who b{font-size:14.5px;color:var(--ink-900);font-weight:700;display:block}
.tcard .who span{font-size:13px;color:var(--ink-500)}
@media(max-width:520px){.testi{grid-template-columns:1fr}}

/* 微信引导卡 */
.wechat-sec{background:var(--bg-tint)}
.wechat{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:48px;box-shadow:var(--sh-md)}
.wechat h2{margin-bottom:14px}
.wechat .lead{margin-bottom:22px}
.wlist{display:flex;flex-direction:column;gap:14px;margin-bottom:26px}
.wlist div{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;color:var(--ink-700)}
.wlist svg{color:var(--em-500);flex:none;margin-top:3px}
.wx-id{display:inline-flex;align-items:center;gap:10px;background:var(--em-50);border:1px dashed var(--em-300);border-radius:12px;padding:12px 18px;font-weight:700;color:var(--em-800);font-size:16px}
.wx-id svg{color:var(--em-600)}
.qr-box{background:linear-gradient(160deg,var(--em-50),#fff);border:1px solid var(--line);border-radius:var(--r-lg);padding:30px;display:grid;place-items:center;box-shadow:var(--sh-sm)}
.qr-svg{width:230px;height:230px;object-fit:contain;background:#fff;border-radius:14px;border:1px solid var(--em-200);padding:8px}
.qr-cap{margin-top:14px;font-size:13px;color:var(--ink-500);text-align:center}
@media(max-width:820px){.wechat{grid-template-columns:1fr;padding:32px 24px;gap:30px}}

/* 为什么选我们 */
.why{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.why .w{display:flex;gap:16px;padding:24px;background:var(--bg-soft);border-radius:var(--r);border:1px solid var(--line);transition:transform .3s var(--ease),background .3s}
.why .w:hover{transform:translateY(-4px);background:#fff;box-shadow:var(--sh-md)}
.why .wic{width:46px;height:46px;border-radius:13px;background:#fff;color:var(--em-600);display:grid;place-items:center;flex:none;box-shadow:var(--sh-sm)}
.why b{display:block;color:var(--ink-900);font-weight:700;font-size:16px;margin-bottom:4px}
.why span{font-size:14px;color:var(--ink-600)}
@media(max-width:880px){.why{grid-template-columns:1fr}}

/* 全宽 CTA */
.cta{text-align:center;padding:var(--s8) 0;background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);margin:0 auto;max-width:var(--maxw)}
.cta h2{color:#fff;max-width:640px;margin:0 auto 18px}
.cta .lead{color:rgba(255,255,255,.85);max-width:520px;margin:0 auto 32px}
.cta-wrap{padding:0 28px}
@media(max-width:880px){.cta{border-radius:0}}

/* 页脚 */
footer{background:var(--ink-900);color:var(--ink-300);padding:72px 0 40px;margin-top:var(--s8)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.foot-brand .brand{color:#fff;margin-bottom:16px}
.foot-brand p{font-size:14.5px;color:var(--ink-400);max-width:280px}
.foot-col h4{color:#fff;font-size:14px;font-weight:700;letter-spacing:.04em;margin-bottom:18px}
.foot-col a{display:block;font-size:14.5px;color:var(--ink-400);padding:7px 0;transition:color .2s}
.foot-col a:hover{color:var(--em-400)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);margin-top:56px;padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink-500)}
@media(max-width:820px){.foot-grid{grid-template-columns:1fr 1fr}.foot-brand{grid-column:1/-1}}

/* reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.08s}.reveal[data-d="2"]{transition-delay:.16s}.reveal[data-d="3"]{transition-delay:.24s}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="container nav-in">
    <div class="brand"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="6.5" stroke="#fff" stroke-width="2.4"/></svg></span>雪球·智慧</div>
    <div class="nav-links"><a href="/earn-haitao">海淘省钱</a><a href="/earn-taobaoke">淘宝客副业</a><a href="/earn-crossborder">跨境副业</a><a href="/category/海淘省钱">省钱攻略</a><a href="/mode">我们的模式</a><a href="/about">关于我们</a></div>
    <a href="#join" class="btn btn-primary">成为 OPC</a>
  </div>
</nav>

<!-- Hero 左文右大图 -->
<header class="hero">
  <div class="hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">OPC 操作系统 · 让普通人跑通自己的小生意</span>
      <h1 class="display">让每一笔消费<br>都变成你的资产</h1>
      <p class="lead">一边用对方法省下日常开销，一边把购物经验变成一份能持续增长的副业收入。雪球·智慧，陪你从省下一笔开始，滚出自己的雪球——无论你是宝妈、上班族还是学生党，这条路都走得通。</p>
      <div class="hero-cta">
        <a href="#join" class="btn btn-primary">成为 OPC
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="#products" class="btn btn-ghost">看看能做什么</a>
      </div>
      <div class="hero-trust">
        <span><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>0 门槛，免费开始</span>
        <span><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>正规平台官方合作</span>
        <span><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>佣金透明可查</span>
      </div>
    </div>
    <div class="hero-visual reveal" data-d="1">
      <img src="/snowballwise_hero.png" alt="雪球·智慧 品牌主视觉">
      <div class="tag"><span class="ic"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="2.2"/></svg></span>今日精选 · 高额返利</div>
    </div>
  </div>
</header>

<!-- 产品三件套 -->
<section class="block" id="products">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">我们提供什么</span>
      <h2>三件套，帮你把省下来的钱滚成收入</h2>
      <p class="lead">不是教你一个赚钱秘方，而是给你一套能长期用的系统——省钱、赚钱、有人陪。</p>
    </div>
    <div class="cards3">
      <div class="pcard reveal" data-d="1">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="2.2"/></svg></div>
        <h3>省钱系统</h3>
        <p>把日常网购变成"先领券再下单"的习惯，同样的东西花更少的钱。</p>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>每日精选高返利好物</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>大促节点攻略与避坑</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>一单一省，积少成多</li>
        </ul>
        <div class="platforms"><span>淘宝客</span><span>京东推客</span><span>拼多多</span></div>
      </div>
      <div class="pcard reveal" data-d="2">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 7v5h-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>副业系统</h3>
        <p>把"会买"变成"会分享"，用现成素材和账号，迈出赚钱第一步。</p>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>手把手注册佣金账号</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>现成种草文案与素材</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>首单成交有激励</li>
        </ul>
        <div class="platforms"><span>淘宝客</span><span>京东推客</span><span>抖音带货</span></div>
