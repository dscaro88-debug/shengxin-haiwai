---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
const joinUrl = SITE.joinUrl;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>关于雪球·智慧 | SnowballWise — 让每一笔省钱都滚得聪明</title>
<meta name="description" content="雪球·智慧 SnowballWise：帮普通人用聪明方式既省下钱也赚到钱。海淘省钱攻略、联盟营销副业训练、高佣 Deal 精选、AI 购物决策。受众包括家庭主理人、上班族、学生党与想轻资产创业的年轻人。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root{
  --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
  --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
  --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
  --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
  --s1:8px;--s2:16px;--s3:24px;--s4:32px;--s5:48px;--s6:64px;--s7:96px;--s8:120px;
  --r-sm:12px;--r:18px;--r-lg:26px;--r-xl:32px;
  --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
  --sh-md:0 6px 16px rgba(15,23,42,.06),0 14px 34px rgba(15,23,42,.08);
  --sh-lg:0 14px 40px rgba(15,23,42,.10),0 36px 80px rgba(15,23,42,.12);
  --sh-em:0 18px 44px rgba(5,150,105,.26);
  --ease:cubic-bezier(.22,.61,.36,1);--ease-out:cubic-bezier(.16,1,.3,1);
  --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
  --maxw:1160px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink-700);background:var(--bg);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.container{max-width:var(--maxw);margin:0 auto;padding:0 28px}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
h1,h2,h3{color:var(--ink-900);letter-spacing:-.025em;line-height:1.1}
.display{font-size:clamp(42px,5.6vw,66px);font-weight:800;letter-spacing:-.035em;line-height:1.06}
h2{font-size:clamp(29px,3.8vw,44px);font-weight:740;letter-spacing:-.025em}
h3{font-size:21px;font-weight:680}
.lead{font-size:clamp(17px,1.5vw,19px);color:var(--ink-600);line-height:1.65}
.muted{color:var(--ink-500)}

.nav{position:fixed;top:0;left:0;right:0;z-index:50;transition:all .4s var(--ease);padding:18px 0}
.nav.scrolled{background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(18px);box-shadow:var(--sh-sm);padding:12px 0}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;color:var(--ink-900)}
.brand .mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(150deg,var(--em-500),var(--em-800));display:grid;place-items:center;box-shadow:var(--sh-em)}
.nav-links{display:flex;gap:30px;font-size:15px;font-weight:500;color:var(--ink-600)}
.nav-links a{transition:color .2s}.nav-links a:hover{color:var(--em-600)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:650;font-size:15px;border-radius:14px;padding:13px 24px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s;cursor:pointer;border:none}
.btn-primary{background:var(--em-600);color:#fff;box-shadow:var(--sh-em)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(5,150,105,.36)}
.btn-ghost{background:#fff;color:var(--ink-800);border:1px solid var(--line);box-shadow:var(--sh-sm)}
.btn-ghost:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
.btn-wechat{background:#07c160;color:#fff;box-shadow:0 14px 32px rgba(7,193,96,.3)}
.btn-wechat:hover{transform:translateY(-2px);box-shadow:0 20px 44px rgba(7,193,96,.4)}
@media(max-width:860px){.nav-links{display:none}}

.page-hero{padding:140px 0 60px;background:radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),radial-gradient(80% 60% at 0% 0%,rgba(6,78,59,.05),transparent 50%),var(--bg);border-bottom:1px solid var(--line)}
.page-hero .display{margin-top:6px;max-width:780px}
.page-hero .lead{margin-top:20px;max-width:600px}

section.block{padding:var(--s8) 0}
.sec-head{max-width:680px;margin:0 auto 56px;text-align:center}
.sec-head .lead{margin-top:16px}

/* 我们做什么 列表 */
.feat{display:flex;flex-direction:column;gap:14px}
.feat .row{display:flex;gap:16px;padding:22px 24px;background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh-sm);align-items:flex-start;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.feat .row:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.feat .ic{width:48px;height:48px;border-radius:14px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;flex:none}
.feat b{display:block;color:var(--ink-900);font-weight:700;font-size:16.5px;margin-bottom:5px}
.feat span{font-size:14.5px;color:var(--ink-600);line-height:1.65}

/* 受众 2x2 */
.cards2{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
.acard{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:30px;box-shadow:var(--sh-sm);position:relative;overflow:hidden;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.acard::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--em-500),var(--em-300))}
.acard:hover{transform:translateY(-6px);box-shadow:var(--sh-lg)}
.acard .pic{width:50px;height:50px;border-radius:14px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:18px}
.acard h3{margin-bottom:8px}
.acard p{font-size:15px;color:var(--ink-600)}
@media(max-width:760px){.cards2{grid-template-columns:1fr}}

/* 理念引用 */
.quote{background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);padding:54px 56px;color:#fff;position:relative;overflow:hidden;box-shadow:var(--sh-em)}
.quote::after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(110,231,183,.18),transparent 70%)}
.quote h2{color:#fff;max-width:680px;font-size:clamp(26px,3.4vw,38px)}
.quote p{color:rgba(255,255,255,.86);font-size:16.5px;max-width:640px;margin-top:14px}
@media(max-width:680px){.quote{padding:38px 26px}}

.note{background:#fffbeb;border:1px solid #fde68a;border-radius:var(--r);padding:20px 22px;color:#92400e;font-size:14.5px;line-height:1.75}
.note b{color:#b45309}

.contact{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.contact .c{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:24px;box-shadow:var(--sh-sm)}
.contact .c .ic{width:44px;height:44px;border-radius:13px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:14px}
.contact .c b{display:block;color:var(--ink-900);font-weight:700;font-size:15px;margin-bottom:4px}
.contact .c span,.contact .c a{font-size:14px;color:var(--ink-600)}
@media(max-width:760px){.contact{grid-template-columns:1fr}}

.cta{text-align:center;padding:var(--s8) 0;background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);margin:0 auto;max-width:var(--maxw)}
.cta h2{color:#fff;max-width:640px;margin:0 auto 18px}
.cta .lead{color:rgba(255,255,255,.85);max-width:520px;margin:0 auto 32px}
.cta-wrap{padding:0 28px}
@media(max-width:880px){.cta{border-radius:0}}

footer{background:var(--ink-900);color:var(--ink-300);padding:72px 0 40px;margin-top:var(--s8)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.foot-brand .brand{color:#fff;margin-bottom:16px}
.foot-brand p{font-size:14.5px;color:var(--ink-400);max-width:280px}
.foot-col h4{color:#fff;font-size:14px;font-weight:700;letter-spacing:.04em;margin-bottom:18px}
.foot-col a{display:block;font-size:14.5px;color:var(--ink-400);padding:7px 0;transition:color .2s}
.foot-col a:hover{color:var(--em-400)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);margin-top:56px;padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink-500)}
@media(max-width:820px){.foot-grid{grid-template-columns:1fr 1fr}.foot-brand{grid-column:1/-1}}

.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.08s}.reveal[data-d="2"]{transition-delay:.16s}.reveal[data-d="3"]{transition-delay:.24s}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
</style>
</head>
<body>

<Header />

<header class="page-hero">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">关于雪球·智慧</span>
      <h1 class="display">让每一笔省钱，<br>都滚得聪明</h1>
      <p class="lead">雪球·智慧（SnowballWise）不是一个优惠搬运站，而是一套「省钱 + 赚钱」的复利系统。我们的使命很简单：让普通人用聪明的方式，既省下钱、也赚到钱——无论你是家庭主理人、上班族、学生党，还是想轻资产创业的年轻人。</p>
    </div>
  </div>
</header>

<!-- 我们做什么 -->
<section class="block">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">我们做什么</span>
      <h2>一套系统，省和赚都给你</h2>
    </div>
    <div class="feat">
      <div class="row reveal" data-d="1">
        <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
        <div><b>海淘省钱 + 赚佣金</b><span>淘宝客、京东联盟——自己买省钱，分享给亲友群还能赚佣金，信息差直接变现。</span></div>
      </div>
      <div class="row reveal" data-d="2">
        <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-4 9 4-9 4-9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 11v5c0 1.5 2 3 5 3s5-1.5 5-3v-5" stroke="currentColor" stroke-width="2"/></svg></div>
        <div><b>副业赚钱训练营</b><span>联盟营销、小红书种草、私域变现——真跑通了才教你的实操课程与陪跑群。</span></div>
      </div>
      <div class="row reveal" data-d="3">
        <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 7l9-4 9 4-9 4-9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 7v10l9 4 9-4V7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
        <div><b>跨境货源（后期路线）</b><span>真实跨境货源是我们规划中的后期路线。前期先不碰货、不开放代发，待省钱 + 副业两条线验证跑通后，再视情况向会员开放练手。</span></div>
      </div>
      <div class="row reveal" data-d="1">
        <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg></div>
        <div><b>AI 省钱决策助手</b><span>规划中——不只告诉你哪里便宜，而是帮你做购买决策：历史低价对比、最优返现方案、是否值得买。</span></div>
      </div>
      <div class="row reveal" data-d="2">
        <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M10 13a4 4 0 0 0 6 0l2-2a4 4 0 1 0-6-6l-1 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 11a4 4 0 0 0-6 0l-2 2a4 4 0 1 0 6 6l1-1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div><b>推广分润网络</b><span>邀请好友加入，他们赚佣金你也拿分成（最多两级分润，合规不碰三级），雪球越滚越大。</span></div>
      </div>
    </div>
  </div>
</section>

<!-- 我们的受众 -->
<section class="block" style="background:var(--bg-soft)">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">我们的受众</span>
      <h2>想让钱更聪明的人，都在这里</h2>
    </div>
    <div class="cards2">
      <div class="acard reveal" data-d="1">
        <div class="pic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
        <h3>家庭主理人（宝妈 / 主夫）</h3>
        <p>想海淘省钱、想在带娃或顾家之余，用手机赚一份踏实的副业收入。</p>
      </div>
      <div class="acard reveal" data-d="2">
        <div class="pic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="2.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="17" cy="9" r="2.6" stroke="currentColor" stroke-width="2.2"/><path d="M15 20a4.5 4.5 0 0 1 6 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></div>
        <h3>上班族 & 学生党</h3>
        <p>想用碎片时间做副业，奶茶钱、零花钱有着落，不占用主业精力。</p>
      </div>
      <div class="acard reveal" data-d="3">
        <div class="pic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M5 20c0-7 5-12 14-13-1 9-6 14-13 14z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 16c2-4 4-6 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
        <h3>想轻资产创业的年轻人</h3>
        <p>想学真本事、不想被割韭菜，把副业当第一门生意练，先跑通再放大。</p>
      </div>
      <div class="acard reveal" data-d="1">
        <div class="pic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="2"/></svg></div>
        <h3>海外华人（Bonus）</h3>
        <p>在美 / 在欧生活，需要信用卡、银行开户、购物返现的实操指导。</p>
      </div>
    </div>
  </div>
</section>

<!-- 理念 -->
<section class="block">
  <div class="container">
    <div class="quote reveal">
      <h2>让每一笔省钱，都滚得聪明。</h2>
      <p>省钱不是抠门，是一种智慧。赚佣金不是投机，是一种复利。我们把这两种能力打包成一套系统，交到你手上。</p>
    </div>
  </div>
</section>

<!-- 透明声明 -->
<section class="block" style="padding-top:0">
  <div class="container">
    <div class="sec-head reveal" style="margin-bottom:28px">
      <span class="eyebrow">透明声明</span>
      <h2>关于联盟链接，我们说清楚</h2>
    </div>
    <div class="note reveal">本站含联盟营销（Affiliate）链接。您通过我们的链接注册或消费，我们可能获得佣金，<b>这不会让您多付一分钱</b>，反而常能帮您拿到专属奖励。我们坚持：只推真实、可验证的优惠，不夸大、不误导。</div>
  </div>
</section>

<!-- 联系我们 -->
<section class="block" style="background:var(--bg-soft)">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">联系我们</span>
      <h2>合作 / 加入 / 洽谈，都欢迎</h2>
    </div>
    <div class="contact">
      <div class="c reveal" data-d="1"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.5 8.5 0 0 1-12 7.7L3 21l1.8-6A8.5 8.5 0 1 1 21 11.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div><b>微信社群</b><a href="#join">点击加入雪球小分队</a></div>
      <div class="c reveal" data-d="2"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><path d="M8 12c2-3 6-3 8 0M8 12c2 3 6 3 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div><b>小红书</b><span>@雪球·智慧</span></div>
      <div class="c reveal" data-d="3"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="2"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div><b>邮箱</b><span>hello@snowballwise.com</span></div>
    </div>
  </div>
</section>

<!-- 全宽 CTA -->
<div class="cta-wrap">
  <section class="cta reveal">
    <h2>和我们一起，把省下的滚成赚到的</h2>
    <p class="lead">加微信进群，今天就能领到《省钱·副业起步包》。</p>
    <a href="#join" class="btn btn-primary" style="font-size:17px;padding:16px 34px;background:#fff;color:var(--em-800);box-shadow:0 18px 44px rgba(0,0,0,.2)">免费加入雪球·智慧</a>
  </section>
</div>

<Footer />

<script>
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>
</body>
</html>
