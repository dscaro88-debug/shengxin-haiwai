---
import { SITE } from '../config';
const joinUrl = SITE.joinUrl;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>跨境副业线 | 雪球·智慧 — 用真实货源练出第一桶金</title>
<meta name="description" content="跨境副业线：依托雪球·智慧真实跨境供应链（义乌小商品 / 假发 / 抹茶），一件代发、不囤货，用老板级货源练出你的副业收入。宝妈、上班族、想轻资产创业的年轻人都适合。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root{
  --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
  --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
  --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
  --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
  --s1:8px;--s2:16px;--s3:24px;--s4:32px;--s5:48px;--s6:64px;--s7:96px;--s8:120px;
  --r-sm:12px;--r:18px;--r-lg:26px;--r-xl:32px;
  --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
  --sh-md:0 6px 16px rgba(15,23,42,.06),0 14px 34px rgba(15,23,42,.08);
  --sh-lg:0 14px 40px rgba(15,23,42,.10),0 36px 80px rgba(15,23,42,.12);
  --sh-em:0 18px 44px rgba(5,150,105,.26);
  --ease:cubic-bezier(.22,.61,.36,1);--ease-out:cubic-bezier(.16,1,.3,1);
  --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
  --maxw:1160px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink-700);background:var(--bg);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.container{max-width:var(--maxw);margin:0 auto;padding:0 28px}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
h1,h2,h3{color:var(--ink-900);letter-spacing:-.025em;line-height:1.1}
.display{font-size:clamp(42px,5.6vw,66px);font-weight:800;letter-spacing:-.035em;line-height:1.06}
h2{font-size:clamp(29px,3.8vw,44px);font-weight:740;letter-spacing:-.025em}
h3{font-size:21px;font-weight:680}
.lead{font-size:clamp(17px,1.5vw,19px);color:var(--ink-600);line-height:1.65}
.muted{color:var(--ink-500)}

.nav{position:fixed;top:0;left:0;right:0;z-index:50;transition:all .4s var(--ease);padding:18px 0}
.nav.scrolled{background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(18px);box-shadow:var(--sh-sm);padding:12px 0}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;color:var(--ink-900)}
.brand .mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(150deg,var(--em-500),var(--em-800));display:grid;place-items:center;box-shadow:var(--sh-em)}
.nav-links{display:flex;gap:30px;font-size:15px;font-weight:500;color:var(--ink-600)}
.nav-links a{transition:color .2s}.nav-links a:hover{color:var(--em-600)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:650;font-size:15px;border-radius:14px;padding:13px 24px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s;cursor:pointer;border:none}
.btn-primary{background:var(--em-600);color:#fff;box-shadow:var(--sh-em)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(5,150,105,.36)}
.btn-ghost{background:#fff;color:var(--ink-800);border:1px solid var(--line);box-shadow:var(--sh-sm)}
.btn-ghost:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
.btn-wechat{background:#07c160;color:#fff;box-shadow:0 14px 32px rgba(7,193,96,.3)}
.btn-wechat:hover{transform:translateY(-2px);box-shadow:0 20px 44px rgba(7,193,96,.4)}
@media(max-width:860px){.nav-links{display:none}}

.page-hero{padding:140px 0 60px;background:radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),radial-gradient(80% 60% at 0% 0%,rgba(6,78,59,.05),transparent 50%),var(--bg);border-bottom:1px solid var(--line)}
.page-hero .display{margin-top:6px;max-width:820px}
.page-hero .lead{margin-top:20px;max-width:600px}
.ph-cta{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap}

section.block{padding:var(--s8) 0}
.sec-head{max-width:680px;margin:0 auto 56px;text-align:center}
.sec-head .lead{margin-top:16px}

.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.pcard{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:34px 30px;box-shadow:var(--sh-sm);transition:transform .35s var(--ease),box-shadow .35s var(--ease);position:relative;overflow:hidden}
.pcard::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--em-500),var(--em-300))}
.pcard:hover{transform:translateY(-8px);box-shadow:var(--sh-lg)}
.pcard .pic{width:56px;height:56px;border-radius:16px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:22px}
.pcard h3{margin-bottom:10px}
.pcard p{font-size:15px;color:var(--ink-600);margin-bottom:18px}
.pcard ul{list-style:none;display:flex;flex-direction:column;gap:11px}
.pcard li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--ink-700)}
.pcard li svg{color:var(--em-500);flex:none;margin-top:3px}
@media(max-width:880px){.cards3{grid-template-columns:1fr}}

.steps5{display:grid;grid-template-columns:repeat(5,1fr);gap:18px}
.step{text-align:center;padding:10px}
.step .num{width:52px;height:52px;margin:0 auto 18px;border-radius:16px;background:var(--bg-tint);border:1px solid var(--em-200);color:var(--em-700);font-weight:800;font-size:20px;display:grid;place-items:center}
.step h3{font-size:18px;margin-bottom:8px}
.step p{font-size:14.5px;color:var(--ink-600)}
.steps5 .step .num{width:46px;height:46px;font-size:18px}
@media(max-width:980px){.steps5{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.steps5{grid-template-columns:1fr}}

.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.stat{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px 24px;box-shadow:var(--sh-sm)}
.stat .n{font-size:30px;font-weight:800;color:var(--em-700);letter-spacing:-.02em;line-height:1.15}
.stat .l{font-size:14px;color:var(--ink-600);margin-top:12px;line-height:1.6}
@media(max-width:880px){.stats{grid-template-columns:1fr}}

.note{background:#fffbeb;border:1px solid #fde68a;border-radius:var(--r);padding:18px 20px;color:#92400e;font-size:14.5px;line-height:1.75;margin-top:28px}
.note b{color:#b45309}

.wechat-sec{background:var(--bg-tint)}
.wechat{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:48px;box-shadow:var(--sh-md)}
.wechat h2{margin-bottom:14px}
.wechat .lead{margin-bottom:22px}
.wlist{display:flex;flex-direction:column;gap:14px;margin-bottom:26px}
.wlist div{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;color:var(--ink-700)}
.wlist svg{color:var(--em-500);flex:none;margin-top:3px}
.wx-id{display:inline-flex;align-items:center;gap:10px;background:var(--em-50);border:1px dashed var(--em-300);border-radius:12px;padding:12px 18px;font-weight:700;color:var(--em-800);font-size:16px}
.wx-id svg{color:var(--em-600)}
.qr-box{background:linear-gradient(160deg,var(--em-50),#fff);border:1px solid var(--line);border-radius:var(--r-lg);padding:30px;display:grid;place-items:center;box-shadow:var(--sh-sm)}
.qr-svg{width:230px;height:230px;object-fit:contain;background:#fff;border-radius:14px;border:1px solid var(--em-200);padding:8px}
.qr-cap{margin-top:14px;font-size:13px;color:var(--ink-500);text-align:center}
@media(max-width:820px){.wechat{grid-template-columns:1fr;padding:32px 24px;gap:30px}}

.cta{text-align:center;padding:var(--s8) 0;background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);margin:0 auto;max-width:var(--maxw)}
.cta h2{color:#fff;max-width:640px;margin:0 auto 18px}
.cta .lead{color:rgba(255,255,255,.85);max-width:520px;margin:0 auto 32px}
.cta-wrap{padding:0 28px}
@media(max-width:880px){.cta{border-radius:0}}

footer{background:var(--ink-900);color:var(--ink-300);padding:72px 0 40px;margin-top:var(--s8)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.foot-brand .brand{color:#fff;margin-bottom:16px}
.foot-brand p{font-size:14.5px;color:var(--ink-400);max-width:280px}
.foot-col h4{color:#fff;font-size:14px;font-weight:700;letter-spacing:.04em;margin-bottom:18px}
.foot-col a{display:block;font-size:14.5px;color:var(--ink-400);padding:7px 0;transition:color .2s}
.foot-col a:hover{color:var(--em-400)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);margin-top:56px;padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink-500)}
@media(max-width:820px){.foot-grid{grid-template-columns:1fr 1fr}.foot-brand{grid-column:1/-1}}

.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.08s}.reveal[data-d="2"]{transition-delay:.16s}.reveal[data-d="3"]{transition-delay:.24s}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="container nav-in">
    <div class="brand"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="6.5" stroke="#fff" stroke-width="2.4"/></svg></span>雪球·智慧</div>
    <div class="nav-links"><a href="/earn-haitao">海淘省钱</a><a href="/earn-taobaoke">淘宝客副业</a><a href="/earn-crossborder">跨境副业</a><a href="/category/海淘省钱">省钱攻略</a><a href="/about">关于我们</a></div>
    <a href="#join" class="btn btn-primary">加入社群</a>
  </div>
</nav>

<header class="page-hero">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">跨境副业线</span>
      <h1 class="display">用老板级的真实货源，<br>练出你的第一桶金</h1>
      <p class="lead">前两条线，赚的是"信息差佣金"。这条线，赚的是"真实货源的差价"——也是雪球·智慧跟所有优惠号最不一样的地方：我们背后是真跑跨境实体生意的团队（义乌小商品采购、假发出海、抹茶出口），我们把自己的供应链开放给会员练手。无论宝妈、上班族还是想轻资产创业的年轻人，都能在这里用老板级货源起步。</p>
      <div class="ph-cta">
        <a href="#how" class="btn btn-primary">看五步怎么开始</a>
        <a href="#join" class="btn btn-ghost">加微信看开放品类</a>
      </div>
    </div>
  </div>
</header>

<!-- 为什么只有我们能给 -->
<section class="block">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">我们的差异化</span>
      <h2>为什么这条线只有我们能给</h2>
      <p class="lead">大部分"副业课"只给 PDF，你学完还是没货可卖。我们直接把货源交到你手上。</p>
    </div>
    <div class="cards3">
      <div class="pcard reveal" data-d="1">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-5 9 5v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 21V12h6v9" stroke="currentColor" stroke-width="2"/></svg></div>
        <h3>真跑跨境实体</h3>
        <p>团队本身在做义乌小商品、假发、抹茶的出口生意，不是二道贩子。</p>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>真实货源，真实成交</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>大博主抄不走的壁垒</li>
        </ul>
      </div>
      <div class="pcard reveal" data-d="2">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 7l9-4 9 4-9 4-9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 7v10l9 4 9-4V7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
        <h3>三件套直接给</h3>
        <p>选品 + 素材 + 一件代发，你负责引流和信任，发货库存我们兜底。</p>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>0 库存风险</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>不用自己找工厂</li>
        </ul>
      </div>
      <div class="pcard reveal" data-d="3">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>真实生意里练手</h3>
        <p>学员在我们的真实跨境生意里跑通第一单，这是大博主抄不走的真实性。</p>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>第一单就有真成交</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>从 0 到 1 全程陪跑</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 五步 -->
<section class="block" id="how" style="background:var(--bg-soft)">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">怎么开始</span>
      <h2>五步，不囤货</h2>
    </div>
    <div class="steps5">
      <div class="step reveal" data-d="1"><div class="num">1</div><h3>选赛道</h3><p>从开放的品类里挑一个你感兴趣、好讲的——假发（高客单）、抹茶 / 健康（趋势）、义乌小商品（走量）。</p></div>
      <div class="step reveal" data-d="2"><div class="num">2</div><h3>拿素材包</h3><p>每个品类给实拍图、卖点话术、小红书 / 朋友圈文案，直接发，不用自己拍。</p></div>
      <div class="step reveal" data-d="3"><div class="num">3</div><h3>内容引流</h3><p>用模板发小红书 / 朋友圈，吸引有需求的精准粉。</p></div>
      <div class="step reveal" data-d="4"><div class="num">4</div><h3>成交代发</h3><p>客户下单你转给我们，我们一件代发，你赚差价，0 库存风险。</p></div>
      <div class="step reveal" data-d="5"><div class="num">5</div><h3>放大</h3><p>跑通一个品，复制其他品，或带自己的推广员做分润，收入滚雪球。</p></div>
    </div>
  </div>
</section>

<!-- 收益模型 -->
<section class="block">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">收益模型</span>
      <h2>卖货赚差价，不压货不亏本金</h2>
    </div>
    <div class="stats">
      <div class="stat reveal" data-d="1"><div class="n">¥60–200</div><div class="l">假发客单 ¥200–600，单件差价；月出 30 单 → ¥1800–6000</div></div>
      <div class="stat reveal" data-d="2"><div class="n">复购强</div><div class="l">抹茶 / 健康品类客户留下来持续买，收入更稳</div></div>
      <div class="stat reveal" data-d="3"><div class="n">0 死账</div><div class="l">不压货 = 没有死账，最坏情况只是"没卖出去"，不会亏本金</div></div>
    </div>
    <div class="note reveal"><b>⚠️ 风险提醒：</b>跨境涉及商标与质检合规，卖货前确认品类可合规销售；不要为了冲量自己压货；客户预期管理要好，物流时效如实说。</div>
  </div>
</section>

<!-- 谁适合 -->
<section class="block" style="background:var(--bg-soft)">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">谁适合这条线</span>
      <h2>想认真做一门能长出来的副业</h2>
    </div>
    <div class="cards3">
      <div class="pcard reveal" data-d="1">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 7v5h-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>想做长期副业的人</h3>
        <p>不怕学着卖货、愿意在小红书 / 微信上经营，要的是能长大的收入。</p>
      </div>
      <div class="pcard reveal" data-d="2">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="2.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="17" cy="9" r="2.6" stroke="currentColor" stroke-width="2.2"/><path d="M15 20a4.5 4.5 0 0 1 6 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></div>
        <h3>家庭主理人 / 上班族 / 轻资产创业青年</h3>
        <p>用碎片时间经营，从一件代发起步，不用自己扛库存和售后。</p>
      </div>
      <div class="pcard reveal" data-d="3">
