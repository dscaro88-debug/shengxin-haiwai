    tags: ['大品牌', '3层加厚'],
    url: 'https://m.tb.cn/h.84cn4an',
  },
  {
    img: '/deals/07-xianlang-catfood.png',
    name: '鲜朗低温烘焙猫粮',
    slogan: '168元 鲜朗烘焙粮',
    price: '¥168.00',
    rate: '佣金 1.35%',
    platform: 'taobao',
    category: '宠物用品',
    tags: ['低温烘焙', '无谷鲜肉'],
    url: 'https://m.tb.cn/h.8f2HHB2',
  },
  {
    img: '/deals/08-1664-beer.png',
    name: '1664桃红啤酒500ml*12罐',
    slogan: '一罐不到8块 姐妹聚会必备',
    price: '¥93.86',
    rate: '佣金 7.80%',
    platform: 'taobao',
    category: '食品',
    tags: ['覆盆子口味', '券后价'],
    url: 'https://m.tb.cn/h.8fWn2Zc',
  },
];

const platforms = [
  { key: 'all', label: '全部平台' },
  { key: 'jd', label: '京东' },
  { key: 'taobao', label: '淘宝' },
  { key: 'douyin', label: '抖音' },
  { key: 'haitao', label: '海淘' },
];

const categories = [
  { key: 'all', label: '全部分类' },
  { key: '日用百货', label: '日用百货' },
  { key: '日用个护', label: '日用个护' },
  { key: '美妆个护', label: '美妆个护' },
  { key: '数码通信', label: '数码通信' },
  { key: '宠物用品', label: '宠物用品' },
  { key: '食品', label: '食品' },
  { key: '服装配饰', label: '服装配饰' },
];

const platformLabel: Record<string, string> = {
  jd: '京东',
  taobao: '淘宝',
  douyin: '抖音',
  haitao: '海淘',
};
---

<Layout
  title="雪球·智慧 — 好物清单：全网好价一网打尽"
  description="雪球·智慧在小红书的真实测评好物，按平台与品类筛选，点击直达京东/淘宝官方，价格不变、优惠实时。"
  image="/deals/01-guangdian-liuliangka.png"
>
  <style is:global>
  :root{
    --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
    --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
    --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
    --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
    --r-sm:10px;--r:14px;--r-lg:18px;--r-xl:24px;
    --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
    --sh-md:0 4px 12px rgba(15,23,42,.06),0 10px 24px rgba(15,23,42,.08);
    --sh-lg:0 10px 30px rgba(15,23,42,.08),0 24px 60px rgba(15,23,42,.10);
    --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hirino Sans GB','Microsoft YaHei',system-ui,sans-serif;
    --maxw:1280px;
  }
  .deals-hero{padding:110px 0 40px;background:radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),var(--bg)}
  .deals-hero .eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:16px;display:inline-flex;align-items:center;gap:8px}
  .deals-hero .eyebrow::before{content:"";width:20px;height:2px;background:var(--em-500);border-radius:2px}
  .deals-hero h1{font-size:clamp(32px,4.2vw,50px);font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--ink-900)}
  .deals-hero .lead{font-size:clamp(15px,1.3vw,17px);color:var(--ink-600);line-height:1.65;margin-top:16px;max-width:640px}

  .filters{padding:28px 0 18px;position:sticky;top:0;z-index:20;background:linear-gradient(180deg,var(--bg) 70%,rgba(255,255,255,0) 100%);backdrop-filter:blur(8px)}
  .filter-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px}
  .filter-row:last-child{margin-bottom:0}
  .filter-label{font-size:13px;font-weight:600;color:var(--ink-500);margin-right:4px;white-space:nowrap}
  .filter-btn{font-size:13.5px;font-weight:500;color:var(--ink-600);background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 15px;cursor:pointer;transition:all .2s;white-space:nowrap}
  .filter-btn:hover{border-color:var(--em-300);color:var(--em-700)}
  .filter-btn.active{background:var(--em-600);border-color:var(--em-600);color:#fff;box-shadow:0 4px 12px rgba(5,150,105,.22)}

  .deals-toolbar{display:flex;align-items:center;justify-content:space-between;margin:10px 0 18px}
  .deals-count{font-size:14px;color:var(--ink-500)}
  .deals-count b{color:var(--ink-900);font-weight:700}

  .deals-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;padding:0 0 48px}
  .deal{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:var(--sh-sm);transition:transform .25s cubic-bezier(.22,.61,.36,1),box-shadow .25s;display:flex;flex-direction:column}
  .deal:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
  .deal.hidden{display:none}
  .deal .thumb{aspect-ratio:3/4;background:var(--bg-soft);overflow:hidden;position:relative}
  .deal .thumb img{width:100%;height:100%;object-fit:cover}
  .deal .body{padding:12px 13px 14px;display:flex;flex-direction:column;gap:7px;flex:1}
  .deal .meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .deal .rate{font-size:11px;font-weight:700;color:var(--em-700);background:var(--em-50);border-radius:5px;padding:3px 7px}
  .deal .cat{font-size:11px;font-weight:500;color:var(--ink-500);background:var(--ink-100);border-radius:5px;padding:3px 7px}
  .deal h3{font-size:14px;font-weight:600;color:var(--ink-900);line-height:1.45;letter-spacing:-.01em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:40px}
  .deal .slogan{font-size:12.5px;font-weight:500;color:var(--em-700);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:32px}
  .deal .tags{display:flex;flex-wrap:wrap;gap:5px}
  .deal .tags span{font-size:11px;color:var(--ink-500);background:var(--bg-soft);border:1px solid var(--line);border-radius:5px;padding:2px 6px}
  .deal .price-row{display:flex;align-items:baseline;justify-content:space-between;margin-top:auto;padding-top:6px}
  .deal .price{font-size:16px;font-weight:800;color:var(--em-700);letter-spacing:-.02em}
  .deal .go{font-size:12px;font-weight:600;color:#fff;background:var(--em-600);border-radius:7px;padding:6px 12px;transition:background .2s}
  .deal .go:hover{background:var(--em-700)}

  @media(max-width:1100px){.deals-grid{grid-template-columns:repeat(5,1fr);gap:16px}}
  @media(max-width:900px){.deals-grid{grid-template-columns:repeat(4,1fr);gap:14px}}
  @media(max-width:680px){.deals-grid{grid-template-columns:repeat(3,1fr);gap:12px}.deal .body{padding:10px 11px 12px}.deal h3{font-size:13px;min-height:36px}}
  @media(max-width:420px){.deals-grid{grid-template-columns:repeat(2,1fr);gap:10px}}

  .empty-state{text-align:center;padding:64px 20px;color:var(--ink-500)}
  .empty-state.hidden{display:none}

  .disclose{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--r-lg);padding:26px 30px;margin:0 0 56px}
  .disclose h4{color:var(--ink-900);font-size:16px;margin-bottom:10px}
  .disclose p{font-size:14px;color:var(--ink-600);line-height:1.65}
  </style>

  <section class="deals-hero">
    <div class="container">
      <span class="eyebrow">好物清单</span>
      <h1>全网好价，一站筛选</h1>
      <p class="lead">每一款都来自雪球·智慧在小红书的真实测评。按平台、按品类快速找到你想要的，点击直达官方下单——价格不变，优惠实时。</p>
    </div>
  </section>

  <div class="container">
    <div class="filters">
      <div class="filter-row">
        <span class="filter-label">平台</span>
        {platforms.map(p => (
          <button class={`filter-btn platform-btn ${p.key === 'all' ? 'active' : ''}`} data-type="platform" data-value={p.key}>{p.label}</button>
        ))}
      </div>
      <div class="filter-row">
        <span class="filter-label">品类</span>
        {categories.map(c => (
          <button class={`filter-btn category-btn ${c.key === 'all' ? 'active' : ''}`} data-type="category" data-value={c.key}>{c.label}</button>
        ))}
      </div>
    </div>

    <div class="deals-toolbar">
      <div class="deals-count">共 <b id="deals-count">{deals.length}</b> 个好物</div>
    </div>

    <div class="deals-grid" id="deals-grid">
      {deals.map((d, idx) => (
        <article class="deal" data-platform={d.platform} data-category={d.category} data-index={idx}>
          <a href={d.url} target="_blank" rel="nofollow noopener" class="thumb">
            <img src={d.img} alt={d.name} loading="lazy" width="600" height="800" />
          </a>
          <div class="body">
            <div class="meta">
              <span class="rate">雪球精选</span>
              <span class="cat">{d.category}</span>
            </div>
            <h3><a href={d.url} target="_blank" rel="nofollow noopener" style="color:inherit;text-decoration:none">{d.name}</a></h3>
            <p class="slogan">{d.slogan}</p>
            <div class="tags">
              {d.tags.map(t => <span>{t}</span>)}
            </div>
            <div class="price-row">
              <span class="price">{d.price}</span>
              <a class="go" href={d.url} target="_blank" rel="nofollow noopener">去{platformLabel[d.platform] || d.platform}</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="empty-state" id="empty-state">
      <p>该筛选条件下暂无商品，换个平台或品类看看。</p>
    </div>

    <div class="disclose">
      <h4>关于佣金与价格</h4>
      <p>本页商品均通过京东联盟 / 淘宝联盟推广链接。您通过链接下单，雪球·智慧可能获得一笔佣金，<b>不会影响您的任何购买价格</b>。所有优惠以各平台官方页面实时信息为准；如链接失效，请在对应平台搜索商品名。</p>
    </div>
  </div>

  <script is:inline>
    (function(){
      const platformBtns = document.querySelectorAll('.platform-btn');
      const categoryBtns = document.querySelectorAll('.category-btn');
      const cards = document.querySelectorAll('.deal');
      const countEl = document.getElementById('deals-count');
      const emptyState = document.getElementById('empty-state');
      let activePlatform = 'all';
      let activeCategory = 'all';

      function update() {
        let visible = 0;
        cards.forEach(card => {
          const p = card.dataset.platform;
          const c = card.dataset.category;
          const matchP = activePlatform === 'all' || p === activePlatform;
          const matchC = activeCategory === 'all' || c === activeCategory;
          if (matchP && matchC) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });
        countEl.textContent = visible;
        emptyState.classList.toggle('hidden', visible > 0);
      }

      function setActive(btns, key) {
        btns.forEach(btn => {
          btn.classList.toggle('active', btn.dataset.value === key);
        });
      }

      platformBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          activePlatform = btn.dataset.value;
          setActive(platformBtns, activePlatform);
          update();
        });
      });

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          activeCategory = btn.dataset.value;
          setActive(categoryBtns, activeCategory);
          update();
        });
      });
    })();
  </script>
</Layout>
