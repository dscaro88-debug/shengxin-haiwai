---
import { SITE } from '../config';
import Layout from '../layouts/Layout.astro';

const deals = [
  {
    img: '/deals/01-guangdian-liuliangka.png',
    name: '中国广电流量卡｜60G/月 · 39元包5年',
    slogan: '39元用5年！60G大流量',
    price: '¥39.00',
    rate: '佣金 80%',
    platform: 'jd',
    category: '数码通信',
    tags: ['大流量', '长期套餐'],
    url: 'https://u.jd.com/UgOfNyO',
  },
  {
    img: '/deals/02-herms-toothbrush.png',
    name: 'HERMS 软毛牙刷套装',
    slogan: '5块钱的牙刷比电动的还好用',
    price: '¥29.90',
    rate: '佣金 35.6%',
    platform: 'jd',
    category: '日用个护',
    tags: ['软毛护龈', '家庭装'],
    url: 'https://u.jd.com/Urate89',
  },
  {
    img: '/deals/03-zhihu-sanitary.png',
    name: '植护卫生巾',
    slogan: '每个月都要用的 别将就',
    price: '¥29.90',
    rate: '佣金 33%',
    platform: 'jd',
    category: '日用个护',
    tags: ['抑菌除味', '大吸收'],
    url: 'https://u.jd.com/UDaCPrH',
  },
  {
    img: '/deals/04-naturetang-skincare.png',
    name: '自然堂护肤套装',
    slogan: '30岁后护肤不用太贵但要够用',
    price: '¥199.00',
    rate: '佣金 30%',
    platform: 'jd',
