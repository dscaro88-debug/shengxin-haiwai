---
import { SITE } from '../config';
import Layout from '../layouts/Layout.astro';
const deals = [
  {
    img: '/deals/01-guangdian-liuliangka.png',
    name: '中国广电流量卡｜60G/月 · 39元包5年',
    rate: '佣金 80%',
    points: ['月均不到 8 元', '60G 大流量', '亲测网速够用'],
    url: 'https://u.jd.com/UgOfNyO',
    note: '家里老人小孩需要流量、副业双卡、想降话费的，都合适',
  },
  {
    img: '/deals/02-herms-toothbrush.png',
    name: 'HERMS 软毛牙刷套装',
    rate: '佣金 35.6%',
    points: ['软毛护龈不出血', '10 倍洁净力', '家庭装够用'],
    url: 'https://u.jd.com/Urate89',
    note: '一家老小换牙刷，比电动的更省心',
  },
  {
    img: '/deals/03-zhihu-sanitary.png',
    name: '植护卫生巾',
    rate: '佣金 33%',
    points: ['抑菌除味', '大吸收不侧漏', '亲肤透气'],
    url: 'https://u.jd.com/UDaCPrH',
    note: '每个月都要用的刚需，别将就',
  },
  {
    img: '/deals/04-naturetang-skincare.png',
    name: '自然堂护肤套装',
    rate: '佣金 30%',
    points: ['国货抗皱', '紧致提亮', '25+ 女性适用'],
    url: 'https://u.jd.com/UrapNjO',
    note: '国货之光，日常护肤不贵也好用',
  },
];
---

<Layout
  title="雪球·智慧 — 好物清单：我们亲自用过、正在推的好物"
  description="雪球·智慧在小红书的真实测评好物，点击直达京东官方，佣金透明、价格不受影响。每款都来自真实使用。"
  image="/deals/01-guangdian-liuliangka.png"
>
  <style is:global>
  :root{
    --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
    --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
    --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
    --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
    --r-sm:12px;--r:18px;--r-lg:26px;--r-xl:32px;
    --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
    --sh-md:0 6px 16px rgba(15,23,42,.06),0 14px 34px rgba(15,23,42,.08);
    --sh-lg:0 14px 40px rgba(15,23,42,.10),0 36px 80px rgba(15,23,42,.12);
    --sh-em:0 18px 44px rgba(5,150,105,.26);
    --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
    --maxw:1160px;
  }
  .deals-hero{padding:120px 0 56px;background:radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),var(--bg)}
  .deals-hero .eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
  .deals-hero .eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
  .deals-hero h1{font-size:clamp(34px,4.6vw,54px);font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--ink-900)}
  .deals-hero .lead{font-size:clamp(16px,1.4vw,18px);color:var(--ink-600);line-height:1.65;margin-top:20px;max-width:620px}
  .sync-bar{margin-top:30px;display:inline-flex;align-items:center;gap:10px;font-size:14px;color:var(--em-700);background:var(--em-50);border:1px solid var(--em-200);border-radius:999px;padding:9px 18px}
  .sync-bar svg{flex:none;color:var(--em-600)}

  .deals-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px;padding:24px 0 40px}
  .deal{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--sh-sm);transition:transform .35s cubic-bezier(.22,.61,.36,1),box-shadow .35s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column}
  .deal:hover{transform:translateY(-6px);box-shadow:var(--sh-lg)}
  .deal .thumb{aspect-ratio:3/4;background:var(--bg-soft);overflow:hidden}
  .deal .thumb img{width:100%;height:100%;object-fit:cover}
  .deal .body{padding:24px 24px 26px;display:flex;flex-direction:column;gap:14px;flex:1}
  .deal .rate{align-self:flex-start;font-size:12.5px;font-weight:700;color:var(--em-700);background:var(--em-50);border-radius:8px;padding:5px 11px}
  .deal h3{font-size:19px;font-weight:700;color:var(--ink-900);line-height:1.35;letter-spacing:-.01em}
  .deal ul{list-style:none;display:flex;flex-direction:column;gap:8px}
  .deal li{display:flex;gap:9px;font-size:14.5px;color:var(--ink-600)}
  .deal li svg{color:var(--em-500);flex:none;margin-top:3px}
  .deal .note{font-size:13.5px;color:var(--ink-500);border-left:3px solid var(--em-200);padding-left:12px;line-height:1.55}
  .deal .go{margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:650;font-size:15px;border-radius:14px;padding:13px 20px;background:var(--em-600);color:#fff;box-shadow:var(--sh-em);transition:transform .25s,box-shadow .25s}
  .deal .go:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(5,150,105,.36)}
  @media(max-width:760px){.deals-grid{grid-template-columns:1fr}}

  .disclose{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px 32px;margin:8px 0 56px}
  .disclose h4{color:var(--ink-900);font-size:16px;margin-bottom:10px}
  .disclose p{font-size:14px;color:var(--ink-600);line-height:1.65}
  .cross{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:8px 0 64px}
  .cross .box{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:30px;box-shadow:var(--sh-sm)}
  .cross .box h4{color:var(--ink-900);font-size:17px;margin-bottom:10px}
  .cross .box p{font-size:14.5px;color:var(--ink-600);line-height:1.65}
  .cross .box a{color:var(--em-600);font-weight:600}
  @media(max-width:760px){.cross{grid-template-columns:1fr}}
  </style>

  <section class="deals-hero">
    <div class="container">
      <span class="eyebrow">好物清单</span>
      <h1>我们亲自用过、正在推的好物</h1>
      <p class="lead">每一款都来自雪球·智慧在小红书的真实测评笔记。点击直达京东官方，佣金透明、价格不受影响——你买到的，就是我们自己也在用的。</p>
      <div class="sync-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 14-5l2 2M20 12a8 8 0 0 1-14 5l-2-2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 4v5h-5M6 20v-5h5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        本页同步自小红书「雪球智慧」已发布笔记，内容可溯源
      </div>
    </div>
  </section>

  <div class="container">
    <div class="deals-grid">
      {deals.map(d => (
        <article class="deal">
          <div class="thumb"><img src={d.img} alt={d.name} loading="lazy" width="600" height="800" /></div>
          <div class="body">
            <span class="rate">{d.rate}</span>
            <h3>{d.name}</h3>
            <ul>
              {d.points.map(p => (
                <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{p}</li>
              ))}
            </ul>
            <p class="note">{d.note}</p>
            <a class="go" href={d.url} target="_blank" rel="nofollow noopener">去京东查看
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M9 7h8v8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
        </article>
      ))}
    </div>

    <div class="disclose">
      <h4>关于佣金与价格</h4>
      <p>本页商品均通过京东联盟推广链接。您通过链接在京东下单，雪球·智慧可能获得一笔佣金，<b>不会影响您的任何购买价格</b>。所有优惠以京东官方页面实时信息为准；如链接失效，请在京东搜索对应商品名。</p>
    </div>

    <div class="cross">
      <div class="box">
        <h4>小红书：看完整测评</h4>
        <p>每款好物的使用体验、选购理由、避坑点，都在小红书「雪球智慧」的笔记里。搜索账号即可看到我们亲自拍的图文，比清单更细。</p>
      </div>
      <div class="box">
        <h4>雪球·智慧：沉淀与入口</h4>
        <p>网站是好物库的长期沉淀（SEO 可搜到），也是「成为 OPC」的入口。想用同样的方法跑通自己的省钱+赚钱小生意，从这里开始。</p>
      </div>
    </div>
  </div>
</Layout>
