---
import { SITE } from '../config';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>雪球·智慧 — 我们的模式：OPC 操作系统</title>
<meta name="description" content="雪球·智慧不是内容号，而是一套 OPC 操作系统：让普通人跑通自己的省钱+赚钱一人公司。三阶段路径、内生裂变与合规红线，一页讲清。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root{
  --em-50:#ecfdf5;--em-100:#d1fae5;--em-200:#a7f3d0;--em-300:#6ee7b7;--em-400:#34d399;
  --em-500:#10b981;--em-600:#059669;--em-700:#047857;--em-800:#065f46;--em-900:#064e3b;--em-950:#022c22;
  --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-400:#94a3b8;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
  --bg:#ffffff;--bg-soft:#f7faf9;--bg-tint:#f3fbf8;--line:#e8edf2;
  --s1:8px;--s2:16px;--s3:24px;--s4:32px;--s5:48px;--s6:64px;--s7:96px;--s8:120px;
  --r-sm:12px;--r:18px;--r-lg:26px;--r-xl:32px;
  --sh-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
  --sh-md:0 6px 16px rgba(15,23,42,.06),0 14px 34px rgba(15,23,42,.08);
  --sh-lg:0 14px 40px rgba(15,23,42,.10),0 36px 80px rgba(15,23,42,.12);
  --sh-em:0 18px 44px rgba(5,150,105,.26);
  --ease:cubic-bezier(.22,.61,.36,1);--ease-out:cubic-bezier(.16,1,.3,1);
  --font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
  --maxw:1160px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink-700);background:var(--bg);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.container{max-width:var(--maxw);margin:0 auto;padding:0 28px}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
h1,h2,h3{color:var(--ink-900);letter-spacing:-.025em;line-height:1.1}
.display{font-size:clamp(42px,5.6vw,66px);font-weight:800;letter-spacing:-.035em;line-height:1.06}
h2{font-size:clamp(29px,3.8vw,44px);font-weight:740;letter-spacing:-.025em}
h3{font-size:21px;font-weight:680}
.lead{font-size:clamp(17px,1.5vw,19px);color:var(--ink-600);line-height:1.65}
.muted{color:var(--ink-500)}

/* 顶栏 */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;transition:all .4s var(--ease);padding:18px 0}
.nav.scrolled{background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(18px);box-shadow:var(--sh-sm);padding:12px 0}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;color:var(--ink-900)}
.brand .mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(150deg,var(--em-500),var(--em-800));display:grid;place-items:center;box-shadow:var(--sh-em)}
.nav-links{display:flex;gap:30px;font-size:15px;font-weight:500;color:var(--ink-600)}
.nav-links a{transition:color .2s}.nav-links a:hover{color:var(--em-600)}.nav-links a.active{color:var(--em-600)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:650;font-size:15px;border-radius:14px;padding:13px 24px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s;cursor:pointer;border:none}
.btn-primary{background:var(--em-600);color:#fff;box-shadow:var(--sh-em)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(5,150,105,.36)}
.btn-ghost{background:#fff;color:var(--ink-800);border:1px solid var(--line);box-shadow:var(--sh-sm)}
.btn-ghost:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
@media(max-width:860px){.nav-links{display:none}}

/* Hero */
.hero{position:relative;padding:148px 0 var(--s7);background:
  radial-gradient(120% 80% at 88% 8%,rgba(16,185,129,.10),transparent 55%),
  radial-gradient(80% 60% at 0% 0%,rgba(6,78,59,.05),transparent 50%),var(--bg);overflow:hidden}
.hero-grid{max-width:var(--maxw);margin:0 auto;padding:0 28px;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}
.hero-copy .display{margin-top:4px}
.hero-copy .lead{margin-top:22px;max-width:520px}
.hero-cta{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap}
.hero-visual{position:relative}
.hero-visual .panel{background:linear-gradient(160deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);padding:38px;color:#fff;box-shadow:var(--sh-lg);position:relative;overflow:hidden}
.hero-visual .panel::after{content:"";position:absolute;right:-70px;top:-70px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(110,231,183,.18),transparent 70%)}
.hero-visual .panel h3{color:#fff;margin-bottom:14px;position:relative;z-index:2}
.hero-visual .panel ul{list-style:none;display:flex;flex-direction:column;gap:12px;position:relative;z-index:2}
.hero-visual .panel li{display:flex;gap:10px;font-size:15px;color:rgba(255,255,255,.9)}
.hero-visual .panel li svg{color:#6ee7b7;flex:none;margin-top:3px}
@media(max-width:880px){.hero-grid{grid-template-columns:1fr;gap:40px}.hero-visual{order:-1}}

/* 通用 section */
section.block{padding:var(--s8) 0}
.sec-head{max-width:720px;margin:0 auto 56px;text-align:center}
.sec-head .lead{margin-top:16px}

/* 卡片 */
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.pcard{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:34px 30px;box-shadow:var(--sh-sm);transition:transform .35s var(--ease),box-shadow .35s var(--ease);position:relative;overflow:hidden}
.pcard::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--em-500),var(--em-300))}
.pcard:hover{transform:translateY(-8px);box-shadow:var(--sh-lg)}
.pcard .pic{width:56px;height:56px;border-radius:16px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:22px}
.pcard h3{margin-bottom:10px}
.pcard p{font-size:15px;color:var(--ink-600)}
@media(max-width:880px){.cards3{grid-template-columns:1fr}}

/* 三阶段步骤 */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.step{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:34px 30px;box-shadow:var(--sh-sm);position:relative}
.step .num{width:52px;height:52px;border-radius:16px;background:var(--bg-tint);border:1px solid var(--em-200);color:var(--em-700);font-weight:800;font-size:20px;display:grid;place-items:center;margin-bottom:18px}
.step h3{font-size:19px;margin-bottom:10px}
.step p{font-size:15px;color:var(--ink-600)}
.step .tag{display:inline-block;margin-top:16px;font-size:12.5px;font-weight:600;color:var(--em-700);background:var(--em-50);border-radius:8px;padding:5px 11px}
@media(max-width:880px){.steps{grid-template-columns:1fr;gap:18px}}

/* 内生裂变 */
.split{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.fbox{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--r-lg);padding:34px}
.fbox .pic{width:54px;height:54px;border-radius:15px;background:var(--em-50);color:var(--em-600);display:grid;place-items:center;margin-bottom:18px}
.fbox h3{margin-bottom:10px}
.fbox p{font-size:15px;color:var(--ink-600)}
@media(max-width:820px){.split{grid-template-columns:1fr}}

/* 红线铁律 callout */
.redline{background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);padding:54px 56px;color:#fff;position:relative;overflow:hidden;box-shadow:var(--sh-em)}
.redline::after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(110,231,183,.18),transparent 70%)}
.redline .shield{width:54px;height:54px;border-radius:15px;background:rgba(255,255,255,.14);display:grid;place-items:center;margin-bottom:20px;color:#6ee7b7}
.redline h2{color:#fff;max-width:680px}
.redline p{color:rgba(255,255,255,.88);font-size:17px;max-width:660px;margin-top:14px}
.redline ul{list-style:none;display:flex;flex-direction:column;gap:12px;margin-top:22px;position:relative;z-index:2}
.redline li{display:flex;gap:10px;font-size:15.5px;color:rgba(255,255,255,.92)}
.redline li svg{color:#6ee7b7;flex:none;margin-top:3px}
@media(max-width:680px){.redline{padding:38px 26px}}

/* 全宽 CTA */
.cta{text-align:center;padding:var(--s8) 0;background:linear-gradient(135deg,var(--em-700),var(--em-950));border-radius:var(--r-xl);margin:0 auto;max-width:var(--maxw)}
.cta h2{color:#fff;max-width:640px;margin:0 auto 18px}
.cta .lead{color:rgba(255,255,255,.85);max-width:520px;margin:0 auto 32px}
.cta-wrap{padding:0 28px}
@media(max-width:880px){.cta{border-radius:0}}

/* 页脚 */
footer{background:var(--ink-900);color:var(--ink-300);padding:72px 0 40px;margin-top:var(--s8)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.foot-brand .brand{color:#fff;margin-bottom:16px}
.foot-brand p{font-size:14.5px;color:var(--ink-400);max-width:280px}
.foot-col h4{color:#fff;font-size:14px;font-weight:700;letter-spacing:.04em;margin-bottom:18px}
.foot-col a{display:block;font-size:14.5px;color:var(--ink-400);padding:7px 0;transition:color .2s}
.foot-col a:hover{color:var(--em-400)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);margin-top:56px;padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink-500)}
@media(max-width:820px){.foot-grid{grid-template-columns:1fr 1fr}.foot-brand{grid-column:1/-1}}

/* reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
.reveal[data-d="1"]{transition-delay:.08s}.reveal[data-d="2"]{transition-delay:.16s}.reveal[data-d="3"]{transition-delay:.24s}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="container nav-in">
    <div class="brand"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="12" cy="12" r="6.5" stroke="#fff" stroke-width="2.4"/></svg></span>雪球·智慧</div>
    <div class="nav-links"><a href="/earn-haitao">海淘省钱</a><a href="/earn-taobaoke">淘宝客副业</a><a href="/earn-crossborder">跨境副业</a><a href="/category/海淘省钱">省钱攻略</a><a href="/mode" class="active">我们的模式</a><a href="/about">关于我们</a></div>
    <a href="/join" class="btn btn-primary">成为 OPC</a>
  </div>
</nav>

<!-- Hero -->
<header class="hero">
  <div class="hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">OPC 操作系统</span>
      <h1 class="display">让 1 万个普通人，<br>每人跑通自己的小生意</h1>
      <p class="lead">雪球·智慧不是又一个教人省钱的内容号。我们造一套系统，让宝妈、上班族、学生党、想轻资产创业的年轻人，都能用"省钱 + 赚钱"跑通属于自己的 OPC（一人公司）——而你，是造系统的人。</p>
      <div class="hero-cta">
        <a href="/join" class="btn btn-primary">成为第 N 个 OPC
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="/category/海淘省钱" class="btn btn-ghost">翻阅省钱攻略</a>
      </div>
    </div>
    <div class="hero-visual reveal" data-d="1">
      <div class="panel">
        <h3>你赚的不是一笔佣金</h3>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>抽水：网络内每笔成交的服务费</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>数据：1 万个 OPC 行为汇成的独有资产</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>规则：品牌方想触达网络？付费</li>
        </ul>
      </div>
    </div>
  </div>
</header>

<!-- 核心重构 -->
<section class="block">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">核心重构</span>
      <h2>从"写内容的人"到"造系统的人"</h2>
      <p class="lead">OPC = One Person Company（一人公司）。你不做那个写内容的人，你做让 1 万人能写内容、能赚佣金、能拉下级的系统。</p>
    </div>
    <div class="cards3">
      <div class="pcard reveal" data-d="1">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="2.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="17" cy="9" r="2.6" stroke="currentColor" stroke-width="2.2"/><path d="M15 20a4.5 4.5 0 0 1 6 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></div>
        <h3>OPC 是什么</h3>
        <p>一个普通人，用雪球·智慧系统把"会省"变成"会赚"，跑通属于自己的省钱 + 赚钱小生意。宝妈、上班族、学生党、轻资产创业者，都是 OPC。</p>
      </div>
      <div class="pcard reveal" data-d="2">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 7v5h-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>你的角色</h3>
        <p>先自己跑通模型（OPC #1），再把方法产品化供给大家，最后定规则、握数据。从验证者，变成系统的供给方与规则方。</p>
      </div>
      <div class="pcard reveal" data-d="3">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="2.2"/></svg></div>
        <h3>三层收入</h3>
        <p>抽水（网络成交服务费）+ 数据（行为资产）+ 规则（品牌方付费）。收入来源从"自己写内容"升级为"整个网络的系统价值"。</p>
      </div>
    </div>
  </div>
</section>

<!-- 三阶段 -->
<section class="block" style="background:var(--bg-soft)">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">三阶段路径</span>
      <h2>单 OPC → 多 OPC 网络 → 平台 / 数据公司</h2>
      <p class="lead">倒推正做：脑子想的是终局（平台 / 数据公司），手干的是起点（跑通第一个 OPC）。</p>
    </div>
    <div class="steps">
      <div class="step reveal" data-d="1">
        <div class="num">1</div>
        <h3>阶段一：单 OPC 验证</h3>
        <p>你一个人跑通：内容 → 返利佣金 → 招下级。证明"普通人用雪球方法真能赚到钱"。产物：首笔佣金 + 前 10 个下级。</p>
        <span class="tag">当前所在</span>
      </div>
      <div class="step reveal" data-d="2">
        <div class="num">2</div>
        <h3>阶段二：多 OPC 网络</h3>
        <p>把方法产品化：内容模板库、佣金管理后台、两级关系系统。每个 OPC 都是自驱裂变节点，你从写手变成平台方。</p>
        <span class="tag">裂变放大</span>
      </div>
      <div class="step reveal" data-d="3">
        <div class="num">3</div>
        <h3>阶段三：平台 / 数据公司</h3>
        <p>平台层收 SaaS 费，数据层握独有资产，规则层向品牌方收费。你从"卖货的人"变成"定规则的人"。</p>
        <span class="tag">终局</span>
      </div>
    </div>
  </div>
</section>

<!-- 内生裂变 -->
<section class="block">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">为什么能高裂变</span>
      <h2>裂变不是你推的，是结构内生的</h2>
      <p class="lead">一个 OPC 赚了钱，天然想拉朋友一起——因为朋友成交他能拿直推奖励。每个节点都是发动机，不用你花钱买流量。</p>
    </div>
    <div class="split">
      <div class="fbox reveal" data-d="1">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
        <h3>网络效应</h3>
        <p>OPC 越多，对每个 OPC 价值越大——素材库更全、选品更准。进来的人越多，留下的人越稳。</p>
      </div>
      <div class="fbox reveal" data-d="2">
        <div class="pic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 7v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>数据飞轮</h3>
        <p>OPC 行为 → 数据 → 更聪明的选品与推荐 → 更多 OPC。越转越快，这是别人抄不走的资产。</p>
      </div>
    </div>
  </div>
</section>

<!-- 红线铁律 -->
<section class="block">
  <div class="container">
    <div class="redline reveal">
      <div class="shield"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <h2>红线铁律：分佣最多两级，坚决不碰三级</h2>
