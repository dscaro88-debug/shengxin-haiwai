---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
const joinUrl = SITE.joinUrl;
const API_BASE = 'https://snowballwise-opc-production.up.railway.app';
---
<Layout
  title="宝妈怎么用雪球·智慧赚返现 | 雪球·智慧"
  description="你本来就要买母婴 / 日用品。通过雪球·智慧买 = 同样的钱拿回一部分返现；把链接分享给朋友，朋友也省，你再多赚一层。零成本、零风险，两级返现红线内运行。"
>
  <style>
    :root{
      --em-500:#10b981;--em-600:#059669;--em-700:#047857;
      --ink-900:#0b1220;--ink-800:#172033;--ink-700:#334155;--ink-600:#475569;--ink-500:#64748b;--ink-300:#cbd5e1;--ink-200:#e2e8f0;--ink-100:#f1f5f9;--ink-50:#f8fafc;
      --bg:#ffffff;--bg-soft:#f7faf9;--line:#e8edf2;
      --r:18px;--r-lg:26px;--font:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
      --maxw:1160px;
    }
    .hero{padding:72px 0 40px}
    .eyebrow{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--em-600);margin-bottom:18px;display:inline-flex;align-items:center;gap:8px}
    .eyebrow::before{content:"";width:22px;height:2px;background:var(--em-500);border-radius:2px}
    h1{font-size:clamp(34px,4.4vw,52px);font-weight:800;letter-spacing:-.03em;line-height:1.08;color:var(--ink-900);margin:0 0 16px}
    .lead{font-size:17px;color:var(--ink-600);max-width:640px;line-height:1.75}
    .hero-card{margin-top:28px;background:linear-gradient(135deg,#ecfdf5,#f0fdfa);border:1px solid #d1fae5;border-radius:var(--r-lg);padding:28px 32px}
    .hero-card b{color:var(--em-700)}

    .section{padding:40px 0}
    .steps{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:24px}
    .step{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:22px;display:flex;gap:16px;align-items:flex-start}
    .num{flex:0 0 34px;height:34px;border-radius:50%;background:var(--em-600);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px}
    .step h3{margin:0 0 6px;font-size:16px;color:var(--ink-900)}
    .step p{margin:0;font-size:14px;color:var(--ink-600);line-height:1.6}

    .split{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:start;margin-top:24px}
    .commission{background:var(--ink-900);color:#fff;border-radius:var(--r-lg);padding:30px}
    .commission h3{margin:0 0 18px;font-size:18px;color:#fff}
    .chain{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}
    .chain span{padding:8px 14px;border-radius:999px;font-size:14px;font-weight:600}
    .b{background:var(--em-500)} .l1{background:#7c3aed} .l2{background:#d97706} .pf{background:#475569}
    .commission p{font-size:14px;color:#cbd5e1;line-height:1.7;margin:10px 0 0}
    .example{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:26px}
    .example h3{margin:0 0 14px;font-size:16px;color:var(--ink-900)}
    .example .row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--line);font-size:14px}
    .example .row:last-child{border-bottom:0}
    .example .row span:last-child{font-weight:700;color:var(--em-700)}

    .redline{margin-top:24px;background:#fff7ed;border:1px solid #fed7aa;border-radius:var(--r);padding:20px 24px;font-size:14px;color:#9a3412;line-height:1.7}
    .redline b{color:#7c2d12}

    /* 注册 / 登录面板：左右分栏同时显示 */
    .auth-wrap{margin-top:40px;background:linear-gradient(135deg,#f0fdf4,#ecfeff);border:1px solid #d1fae5;border-radius:var(--r-lg);padding:36px}
    .auth-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
    .auth-col{display:flex;flex-direction:column;gap:16px}
    .auth-heading{background:var(--em-600);color:#fff;border:1px solid var(--em-600);border-radius:10px;padding:12px;font-size:15px;font-weight:600;text-align:center}
    .auth-form{display:flex;flex-direction:column;gap:14px}
    .auth-form label{font-size:13px;font-weight:600;color:var(--ink-700)}
    .auth-form input{border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:15px;background:#fff;outline:none}
    .auth-form input:focus{border-color:var(--em-500)}
    .auth-form .row-ref{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-500)}
    .auth-form .row-ref input{flex:1}
    .btn{display:inline-block;background:var(--em-500);color:#fff;font-weight:600;padding:13px 28px;border-radius:12px;font-size:15px;border:0;cursor:pointer;position:relative}
    .btn:hover{background:var(--em-600)}
    .btn:disabled{opacity:.7;cursor:not-allowed}
    .btn.ghost{background:transparent;border:1px solid var(--em-500);color:var(--em-700);margin-left:10px}
    .btn.ghost:hover{background:#f0fdf4}
    .err{color:#b91c1c;font-size:14px;margin-top:8px;display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 12px}
    .err.on{display:block}
    .ok{color:#047857;font-size:14px;margin-top:8px;display:none;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:8px;padding:10px 12px}
    .ok.on{display:block}
    .success-box{margin:24px 0;padding:24px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:14px;display:none}
    .success-box.on{display:block}
    .success-box h4{margin:0 0 12px;color:#065f46;font-size:18px}
    .success-box .big-code{font-size:28px;font-weight:800;color:#047857;font-family:'SF Mono',Monaco,monospace;letter-spacing:.05em}
    .success-box .share-link{font-size:13px;color:#065f46;word-break:break-all;margin-top:8px;display:block}
    .hint{font-size:13px;color:var(--ink-500);margin-top:10px;line-height:1.7}

    /* 已登录面板 */
    .dash{margin-top:40px;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:36px}
    .dash h3{margin:0 0 18px;font-size:20px;color:var(--ink-900)}
    .dash .kv{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:24px}
    .dash .kv>div{background:var(--bg-soft);border:1px solid var(--line);border-radius:14px;padding:16px}
    .dash .kv .lab{font-size:12px;color:var(--ink-500);letter-spacing:.06em;text-transform:uppercase}
    .dash .kv .val{font-size:22px;font-weight:800;color:var(--ink-900);margin-top:6px}
    .promo-box{background:var(--ink-900);color:#fff;border-radius:14px;padding:20px 24px;margin-bottom:20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .promo-box .code{font-size:24px;font-weight:800;letter-spacing:.06em;color:var(--em-500);font-family:'SF Mono',Monaco,monospace}
    .promo-box .link{font-family:'SF Mono',Monaco,monospace;font-size:13px;color:#cbd5e1;word-break:break-all;flex:1;min-width:0}
    .promo-box .copy{background:var(--em-500);color:#fff;border:0;padding:8px 14px;border-radius:8px;font-size:13px;cursor:pointer;font-weight:600}
    .promo-box .copy:hover{background:var(--em-600)}
    .ledger{margin-top:14px;border-top:1px solid var(--line);padding-top:14px}
    .ledger h4{font-size:14px;color:var(--ink-700);margin:0 0 10px}
    .ledger .empty{font-size:13px;color:var(--ink-500);text-align:center;padding:20px}
    .ledger .item{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px dashed var(--line);font-size:14px}
    .ledger .item:last-child{border-bottom:0}
    .ledger .item .amt{font-weight:700;color:var(--em-700)}
    .actions{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}
    .actions .small{background:#fff;border:1px solid var(--line);color:var(--ink-700);padding:10px 16px;border-radius:10px;font-size:13px;cursor:pointer}
    .actions .small:hover{border-color:var(--em-500);color:var(--em-700)}
    .hidden{display:none}

    @media(max-width:760px){.steps,.split,.dash .kv,.auth-grid{grid-template-columns:1fr}}
  </style>

  <section class="hero">
    <div class="eyebrow">宝妈副业 · 两级返现</div>
    <h1>你本来就要买，<br/>不如买完还能赚回来</h1>
    <p class="lead">通过雪球·智慧下单，同样的钱拿回一部分返现；把链接分享给朋友，朋友也省，你再多赚一层。零成本、零风险，全程在「两级分销」红线内运行。</p>
    <div class="hero-card">
      一句话逻辑：<b>商家出推广佣金 → 我们分一部分返现给你让你更省 → 差价就是平台利润</b>。你越分享，省得越多、赚得越多。
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">四步跑通</div>
    <h2 style="font-size:24px;color:var(--ink-900);margin:0">从注册到提现，几分钟的事</h2>
    <div class="steps">
      <div class="step"><div class="num">1</div><div><h3>注册拿码</h3><p>用邮箱注册，系统给你一个专属推广码（promo code），终身绑定。</p></div></div>
      <div class="step"><div class="num">2</div><div><h3>生成专属链接</h3><p>你的链接长这样：<code style="background:#f0fdfa;padding:2px 6px;border-radius:6px;color:var(--em-700)">/go/你的推广码</code>。朋友点它去商城下单，系统用推广码记录归属。</p></div></div>
      <div class="step"><div class="num">3</div><div><h3>两级返现</h3><p>朋友（一级）下单你拿一级分佣；朋友推荐的朋友（二级）下单你拿二级分佣。<b style="color:var(--em-700)">三级及以上不发</b>（红线）。</p></div></div>
      <div class="step"><div class="num">4</div><div><h3>提现</h3><p>余额累计到阈值，微信转账给你（微信 / 支付宝商户号跑通后自动提现）。</p></div></div>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">分佣结构</div>
    <h2 style="font-size:24px;color:var(--ink-900);margin:0">钱怎么分（占联盟佣金比例）</h2>
    <div class="split">
      <div class="commission">
        <h3>每一笔佣金这样拆</h3>
        <div class="chain">
          <span class="b">自购返现 50%</span>
          <span class="l1">一级 30%</span>
          <span class="l2">二级 10%</span>
          <span class="pf">平台 10%</span>
        </div>
        <p>比例固定在系统里，公开透明，不会偷偷改。平台只留最小一块作为运营，绝大部分返给用户和推广者。</p>
      </div>
      <div class="example">
        <h3>真实算一笔（海淘场景）</h3>
        <div class="row"><span>朋友海淘 ¥300 保健品</span><span>佣金 15%</span></div>
        <div class="row"><span>联盟佣金合计</span><span>¥45.00</span></div>
        <div class="row"><span>朋友拿自购返现（50%）</span><span>¥22.50</span></div>
        <div class="row"><span>你拿一级分佣（30%）</span><span>¥13.50</span></div>
        <div class="row"><span>平台留存（10%）</span><span>¥4.50</span></div>
        <p style="font-size:13px;color:var(--ink-500);margin-top:14px">朋友觉得「比自己海淘省了 ¥22.5」，持续用；你零成本多一笔收入。</p>
      </div>
    </div>
    <div class="redline">
      <b>🔴 两级红线（不可降级）：</b>系统只记录「推荐人 → 被推荐人」两级映射，超出两级即触传销红线，永不构建。你推荐 A（一级）、A 推荐 B（二级），B 之下不再计佣。这是 snowballwise 的合规底线，已写进分佣引擎强制拦截。
    </div>
  </section>

  <!-- 全局成功提示（注册成功后即使 dashboard 渲染失败也能看到） -->
  <section id="global-success" class="success-box">
    <h4>🎉 注册成功！你的推广码：</h4>
    <div class="big-code" id="global-code">--</div>
    <div class="share-link" id="global-link">--</div>
    <p style="margin:12px 0 0;color:#065f46;font-size:14px">把这个链接分享到小红书/朋友圈，朋友通过它下单，你自动赚返现。</p>
  </section>

  <!-- 注册/登录面板：左右分栏同时显示 -->
  <section id="auth-panel" class="auth-wrap">
    <div class="auth-grid">
      <!-- 左栏：注册 -->
      <div class="auth-col">
        <div class="auth-heading">注册拿推广码</div>
        <form id="form-register" class="auth-form">
          <h3 style="margin:0 0 18px;font-size:20px;color:var(--ink-900)">注册账号，领取推广码</h3>
          <div>
            <label>邮箱（用作账号 + 找回密码）</label>
            <input type="email" id="reg-email" placeholder="you@example.com" required />
          </div>
          <div>
            <label>密码（至少 6 位）</label>
            <input type="password" id="reg-password" placeholder="******" minlength="6" required />
          </div>
          <div class="row-ref">
            <label style="font-size:13px;font-weight:600;color:var(--ink-700);flex:0 0 auto">推荐人推广码（可选）</label>
            <input type="text" id="reg-ref" placeholder="留空表示自己注册" />
          </div>
          <button class="btn" type="submit" id="reg-btn">立即注册</button>
          <div class="err" id="reg-err"></div>
          <div class="ok" id="reg-ok">注册成功！正在生成你的推广码…</div>
          <div class="hint">注册即同意：你必须年满 18 周岁，仅限中国大陆境内参与；分享链接应发布在允许「返利 / 联盟营销」的渠道。注册后页面会直接显示推广码，无需等待邮件。</div>
        </form>
      </div>

      <!-- 右栏：登录 -->
      <div class="auth-col">
        <div class="auth-heading">已有账号？登录</div>
        <form id="form-login" class="auth-form">
          <h3 style="margin:0 0 18px;font-size:20px;color:var(--ink-900)">欢迎回来，请登录</h3>
          <div>
            <label>邮箱</label>
            <input type="email" id="login-email" placeholder="you@example.com" required />
          </div>
          <div>
            <label>密码</label>
            <input type="password" id="login-password" placeholder="******" required />
          </div>
          <button class="btn" type="submit" id="login-btn">登录</button>
          <div class="err" id="login-err"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- 已登录面板（默认隐藏） -->
  <section id="dash-panel" class="dash hidden">
    <h3>👋 你好，<span id="dash-email">--</span></h3>
    <div class="kv">
      <div>
        <div class="lab">可提现余额</div>
        <div class="val">¥ <span id="dash-balance">0.00</span></div>
      </div>
      <div>
        <div class="lab">推广层级</div>
        <div class="val">第 <span id="dash-depth">0</span> 级</div>
      </div>
    </div>

    <div class="promo-box">
      <div>
        <div style="font-size:11px;color:#94a3b8;letter-spacing:.1em;text-transform:uppercase">你的推广码</div>
        <div class="code" id="dash-code">--</div>
      </div>
      <div>
        <div style="font-size:11px;color:#94a3b8;letter-spacing:.1em;text-transform:uppercase">分享链接</div>
        <div class="link" id="dash-link">--</div>
      </div>
      <button class="copy" id="dash-copy-main">复制链接</button>
    </div>

    <div class="ledger">
      <h4>返现明细（实时）</h4>
      <div id="dash-ledger"><div class="empty">暂无返现记录</div></div>
    </div>

    <div class="actions">
      <button class="small" id="dash-copy-action">复制推广链接</button>
      <button class="small" id="dash-logout">退出登录</button>
      <a class="small" href="/deals" style="text-decoration:none;display:inline-block">去看优惠商品 →</a>
    </div>
  </section>

  <script is:inline define:vars={{ API_BASE, joinUrl }}>
    const API = API_BASE;
    let TOKEN = localStorage.getItem('sb_token') || '';
    let USER = null;

    function showError(elId, msg) {
      const el = document.getElementById(elId);
      el.textContent = msg;
      el.classList.add('on');
      const ok = document.getElementById(elId.replace('-err','-ok'));
      if (ok) ok.classList.remove('on');
    }
    function hideError(elId) {
      document.getElementById(elId).classList.remove('on');
    }
    function showOk(elId, msg) {
      const el = document.getElementById(elId);
      el.textContent = msg;
      el.classList.add('on');
    }

    function setLoading(id, loading) {
      const btn = document.getElementById(id);
      btn.disabled = loading;
      btn.dataset.original = btn.dataset.original || btn.textContent;
      btn.textContent = loading ? '处理中…' : btn.dataset.original;
    }

    async function callApi(path, opts = {}) {
      const headers = { 'Content-Type': 'application/json' };
      if (TOKEN) headers.Authorization = 'Bearer ' + TOKEN;
      let r;
      try {
        r = await fetch(API + path, { ...opts, headers: { ...headers, ...(opts.headers || {}) } });
      } catch (netErr) {
        throw new Error('网络连接失败，请检查网络或换个浏览器（避免微信内置浏览器）重试。');
      }
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || ('服务器错误 ' + r.status));
      return data;
    }

    async function doRegister(e) {
      e.preventDefault();
      hideError('reg-err');
      const email = document.getElementById('reg-email').value.trim();
      const password = document.getElementById('reg-password').value;
      const ref = document.getElementById('reg-ref').value.trim();
      if (!email || !password || password.length < 6) {
        showError('reg-err', '请填写有效邮箱和至少 6 位密码。');
        return;
      }
      setLoading('reg-btn', true);
      try {
        const body = { email, password };
        if (ref) body.referralCode = ref;
        showOk('reg-ok', '正在连接服务器，请稍候…');
        const out = await callApi('/api/register', { method: 'POST', body: JSON.stringify(body) });
        TOKEN = out.token;
        localStorage.setItem('sb_token', TOKEN);
        USER = out.user;
        showOk('reg-ok', '注册成功！推广码：' + USER.promoCode);
        renderDash();
      } catch (e) {
        showError('reg-err', '注册失败：' + e.message);
      } finally {
        setLoading('reg-btn', false);
      }
    }

    async function doLogin(e) {
      e.preventDefault();
      hideError('login-err');
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;
      setLoading('login-btn', true);
      try {
        const out = await callApi('/api/login', { method: 'POST', body: JSON.stringify({ email, password }) });
        TOKEN = out.token;
        localStorage.setItem('sb_token', TOKEN);
        USER = out.user;
        renderDash();
      } catch (e) {
        showError('login-err', '登录失败：' + e.message);
      } finally {
        setLoading('login-btn', false);
      }
    }

    function doLogout() {
      TOKEN = ''; USER = null;
      localStorage.removeItem('sb_token');
      document.getElementById('auth-panel').classList.remove('hidden');
      document.getElementById('dash-panel').classList.add('hidden');
      document.getElementById('global-success').classList.remove('on');
    }

    function copyLink(e) {
      const link = document.getElementById('dash-link').textContent;
      navigator.clipboard.writeText(link).then(() => {
        const btn = e && e.target ? e.target : document.querySelector('.promo-box .copy');
        const old = btn.textContent;
        btn.textContent = '已复制 ✓';
        setTimeout(() => btn.textContent = old, 1500);
      });
    }

    function showGlobalSuccess() {
      const box = document.getElementById('global-success');
      document.getElementById('global-code').textContent = USER.promoCode;
      document.getElementById('global-link').textContent = USER.referralLink;
      box.classList.add('on');
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function renderDash() {
      try {
        document.getElementById('auth-panel').classList.add('hidden');
        document.getElementById('dash-panel').classList.remove('hidden');
        document.getElementById('dash-email').textContent = USER.email;
        document.getElementById('dash-code').textContent = USER.promoCode;
        document.getElementById('dash-link').textContent = USER.referralLink;
        document.getElementById('dash-balance').textContent = USER.balance.toFixed(2);
        document.getElementById('dash-depth').textContent = USER.depth;
        loadLedger();
      } catch (err) {
        console.error('dashboard 渲染失败，启用兜底显示', err);
      }
      showGlobalSuccess();
    }

    async function loadLedger() {
      try {
        const out = await callApi('/api/ledger');
        const el = document.getElementById('dash-ledger');
        document.getElementById('dash-balance').textContent = out.balance.toFixed(2);
        if (!out.ledger.length) { el.innerHTML = '<div class="empty">暂无返现记录</div>'; return; }
        el.innerHTML = out.ledger.slice(0, 20).map(l => `
          <div class="item">
            <span>${new Date(l.createdAt).toLocaleString('zh-CN')} · ${escapeHtml(l.note || l.type)}</span>
            <span class="amt">+¥${l.amount.toFixed(2)}</span>
          </div>
        `).join('');
      } catch (e) { /* 忽略，账本为空时 API 401 不显示 */ }
    }

    function escapeHtml(s) { return String(s).replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c])); }

    // 启动时若有 token，自动尝试恢复登录态
    if (TOKEN) {
      callApi('/api/me').then(out => { USER = out.user; renderDash(); })
        .catch(() => { TOKEN = ''; localStorage.removeItem('sb_token'); });
    }

    // 用 addEventListener 绑定事件，彻底避开 Astro IIFE / inline onclick 作用域问题
    document.getElementById('form-register').addEventListener('submit', doRegister);
    document.getElementById('form-login').addEventListener('submit', doLogin);
    document.getElementById('dash-copy-main').addEventListener('click', copyLink);
    document.getElementById('dash-copy-action').addEventListener('click', copyLink);
    document.getElementById('dash-logout').addEventListener('click', doLogout);

    // 兼容内联事件（万一其他页面/调试用到）
    window.doRegister = doRegister;
    window.doLogin = doLogin;
    window.copyLink = copyLink;
    window.doLogout = doLogout;
  </script>

  <p class="note" style="text-align:center;font-size:13px;color:var(--ink-500);margin-top:36px">
    注册 / 登录 / 推广码 / 账本，对应 snowballwise OPC 系统（阶段二 MVP，已部署到 Railway）。
    <a href={joinUrl} style="color:var(--em-700)">遇到问题 → 联系运营</a>
  </p>
</Layout>