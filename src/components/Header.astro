---
import { SITE } from '../config';
const siteTitle = SITE.name;
const joinUrl = SITE.joinUrl;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页' },
  { href: '/apps', label: '网赚任务' },
  { href: '/deals', label: '好物清单' },
  { href: '/earn', label: '赚钱机制' },
  { href: '/category/海淘省钱', label: '省钱攻略' },
  { href: '/mode', label: '我们的模式' },
  { href: '/about', label: '关于' },
  { href: '/cooperation', label: '商务合作' },
];
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};
---
<header class="site-header">
  <div class="container header-in">
    <a href="/" class="logo">
      <img src="/logo.svg" alt={siteTitle} class="logo-icon" width="30" height="30" />
      <span class="logo-text">{siteTitle}</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="btn-wechat desktop" href={joinUrl}>成为 OPC</a>
      <a class="btn-wechat mobile" href={joinUrl}>加入</a>
      <div class="menu-wrap">
        <button class="menu-toggle" id="menu-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
        <span class="tap-hint" id="tap-hint" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/>
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <nav aria-label="移动端导航">
        {nav.map(item => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
        ))}
        <a class="join" href={joinUrl}>成为 OPC →</a>
      </nav>
    </div>
  </div>
</header>

<div class="wechat-tip" id="wechat-tip">
  <span>微信内打开体验受限，建议点右上角「⋯」→「在浏览器中打开」，可添加到手机桌面像 APP 一样用。</span>
  <button aria-label="关闭提示" id="wechat-tip-close">✕</button>
</div>

  <script>
  (function(){
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const tip = document.getElementById('wechat-tip');
    const tipClose = document.getElementById('wechat-tip-close');
    const tapHint = document.getElementById('tap-hint');
    if (!toggle || !menu) return;

    function hideTapHint() {
      if (tapHint) {
        tapHint.classList.add('seen');
        try { localStorage.setItem('sb_menu_tapped', '1'); } catch (_) {}
      }
    }

    function setMenu(open) {
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('menu-open', open);
      if (open) {
        menu.style.display = 'block';
        requestAnimationFrame(() => menu.classList.add('open'));
        hideTapHint();
      } else {
        menu.classList.remove('open');
        setTimeout(() => { if (!menu.classList.contains('open')) menu.style.display = 'none'; }, 240);
      }
    }

    if (tapHint) {
      try {
        if (localStorage.getItem('sb_menu_tapped')) tapHint.classList.add('seen');
      } catch (_) {}
    }

    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    if (tapHint) tapHint.addEventListener('click', hideTapHint);

    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (!menu.contains(target) && !toggle.contains(target) && menu.classList.contains('open')) {
        setMenu(false);
      }
    });

    // 微信内置浏览器检测
    if (tip && /MicroMessenger/i.test(navigator.userAgent)) {
      if (!localStorage.getItem('sb_wechat_tip_closed')) tip.classList.add('show');
    }
    if (tipClose && tip) {
      tipClose.addEventListener('click', () => {
        tip.classList.remove('show');
        try { localStorage.setItem('sb_wechat_tip_closed', '1'); } catch (_) {}
      });
    }
  })();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.88);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line, #e8ebef);
  }
  .header-in { display: flex; align-items: center; gap: 18px; height: 60px; }
  .logo {
    font-weight: 800; font-size: 18px; letter-spacing: -.02em;
    color: var(--ink, #0f172a); text-decoration: none; white-space: nowrap;
    display: flex; align-items: center; gap: 8px; flex: none;
  }
  .logo-icon { display: block; flex: none; }
  .logo-text { font-weight: 800; letter-spacing: .01em; }

  .desktop-nav { display: flex; gap: 2px; flex: 1; align-items: center; justify-content: center; }
  .desktop-nav a {
    color: var(--muted, #64748b); text-decoration: none; font-size: 14px; font-weight: 500;
    padding: 8px 12px; border-radius: 8px; white-space: nowrap; transition: .15s;
  }
  .desktop-nav a:hover { color: var(--ink, #0f172a); background: #eef2f7; }
  .desktop-nav a.active { color: var(--brand, #059669); background: #ecfdf5; font-weight: 600; }

  .header-actions { display: flex; align-items: center; gap: 10px; flex: none; }
  .btn-wechat {
    background: #07c160; color: #fff; padding: 9px 16px; border-radius: 999px;
    text-decoration: none; font-size: 13px; font-weight: 600; white-space: nowrap;
    box-shadow: 0 4px 14px rgba(7,193,96,.35); transition: .15s;
  }
  .btn-wechat:hover { transform: translateY(-1px); }
  .btn-wechat.mobile { display: none; }

  .menu-wrap { position: relative; display: inline-flex; }
  .menu-toggle {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 42px; height: 42px; border: 0; border-radius: 10px;
    background: transparent; cursor: pointer; padding: 0;
  }
  .menu-toggle .bar {
    display: block; width: 22px; height: 2.2px; border-radius: 2px;
    background: var(--ink, #0f172a); margin: 0 auto; transition: .25s;
  }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(1) { transform: translateY(7.2px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(3) { transform: translateY(-7.2px) rotate(-45deg); }

  .tap-hint {
    display: none; position: absolute; right: -2px; top: 34px;
    color: var(--brand, #059669); pointer-events: none; opacity: .92;
    transform: rotate(135deg);
    animation: tap-bounce 1.8s ease-in-out 4;
  }
  .tap-hint.seen { display: none !important; }
  @keyframes tap-bounce {
    0%, 100% { transform: rotate(135deg) translate(0, 0); }
    50% { transform: rotate(135deg) translate(-3px, 3px); }
  }

  .mobile-menu {
    display: none; position: absolute; top: 60px; left: 0; right: 0;
    background: rgba(255,255,255,.97); backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line, #e8ebef);
    box-shadow: 0 14px 34px rgba(15,23,42,.10);
    opacity: 0; transform: translateY(-10px); transition: opacity .25s, transform .25s;
  }
  .mobile-menu.open { opacity: 1; transform: translateY(0); }
  .mobile-menu-inner { padding: 10px 20px 22px; }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 2px; }
  .mobile-menu nav a {
    color: var(--ink, #0f172a); text-decoration: none; font-size: 16px; font-weight: 500;
    padding: 14px 10px; border-radius: 10px; transition: .15s;
    border-bottom: 1px solid var(--line, #e8ebef);
  }
  .mobile-menu nav a:last-of-type { border-bottom: none; }
  .mobile-menu nav a:hover { background: #f8fafc; }
  .mobile-menu nav a.active { color: var(--brand, #059669); background: #ecfdf5; font-weight: 600; }
  .mobile-menu nav a.join {
    margin-top: 8px; background: #07c160; color: #fff; text-align: center;
    font-weight: 700; border: none; box-shadow: 0 4px 14px rgba(7,193,96,.35);
  }
  .mobile-menu nav a.join:hover { background: #06ae56; }

  .wechat-tip {
    display: none; align-items: center; justify-content: space-between; gap: 12px;
    background: #fffbeb; border-bottom: 1px solid #fde68a; color: #92400e;
    padding: 10px 20px; font-size: 13px; font-weight: 500; line-height: 1.5;
  }
  .wechat-tip.show { display: flex; }
  .wechat-tip button {
    background: transparent; border: 0; color: #92400e; font-size: 16px; cursor: pointer; padding: 4px;
  }

  @media (max-width: 820px) {
    .desktop-nav { display: none; }
    .btn-wechat.desktop { display: none; }
    .btn-wechat.mobile { display: inline-flex; padding: 7px 12px; font-size: 12px; }
    .menu-toggle { display: flex; }
    .tap-hint { display: block; }
    .header-in { gap: 10px; }
  }

  @media (min-width: 821px) {
    .mobile-menu { display: none !important; }
    body.menu-open { overflow: auto; }
  }
</style>
