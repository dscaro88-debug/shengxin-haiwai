---
import { SITE } from '../config';
const siteTitle = SITE.name;
const joinUrl = SITE.joinUrl;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页' },
  { href: '/earn-haitao', label: '海淘省钱' },
  { href: '/earn-taobaoke', label: '淘宝客副业' },
  { href: '/earn', label: '赚钱机制' },
  { href: '/category/海淘省钱', label: '省钱攻略' },
  { href: '/deals', label: '好物清单' },
  { href: '/mode', label: '我们的模式' },
  { href: '/about', label: '关于' },
  { href: '/cooperation', label: '商务合作' },
];
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};
---
<header class="site-header">
  <div class="container header-in">
    <a href="/" class="logo">
      <img src="/logo.svg" alt={siteTitle} class="logo-icon" width="30" height="30" />
      <span class="logo-text">{siteTitle}</span>
    </a>
    <nav>
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
      ))}
    </nav>
    <a class="btn-wechat" href={joinUrl}>成为 OPC</a>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.82);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line, var(--line-strong, #e8ebef));
  }
  .header-in { display: flex; align-items: center; gap: 18px; height: 64px; }
  .logo {
    font-weight: 800; font-size: 19px; letter-spacing: -.02em;
    color: var(--ink, var(--ink-900, #0b1220)); text-decoration: none; white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
  }
  .logo-icon { display: block; flex: none; }
  .logo-text { font-weight: 800; letter-spacing: .01em; }
  .site-header nav { display: flex; gap: 4px; flex: 1; overflow-x: auto; scrollbar-width: none; }
  .site-header nav::-webkit-scrollbar { display: none; }
  .site-header nav a {
    color: var(--muted, var(--ink-600, #475569)); text-decoration: none; font-size: 14px; font-weight: 500;
    padding: 8px 12px; border-radius: 8px; white-space: nowrap; transition: .15s;
  }
  .site-header nav a:hover { color: var(--ink, var(--ink-900, #0b1220)); background: #eef2f7; }
  .site-header nav a.active { color: var(--brand, var(--em-600, #059669)); background: #ecfdf5; font-weight: 600; }
  .btn-wechat {
    background: #07c160; color: #fff; padding: 9px 16px; border-radius: 999px;
    text-decoration: none; font-size: 13px; font-weight: 600; white-space: nowrap;
    box-shadow: 0 4px 14px rgba(7,193,96,.35); transition: .15s;
  }
  .btn-wechat:hover { transform: translateY(-1px); }
  @media (max-width: 640px) {
    .header-in { gap: 10px; }
    .site-header nav a { padding: 8px 9px; }
  }
</style>
